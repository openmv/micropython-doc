msgstr "磁力計 + ジャイロスコープの非融合モード（\\ ``0x06``\\ ）。"

#: ../../library/omv.bno055.rst:173
msgid "Accelerometer + magnetometer + gyroscope non-fusion mode (``0x07``)."
msgstr "加速度計 + 磁力計 + ジャイロスコープの非融合モード（\\ ``0x07``\\ ）。"

#: ../../library/omv.bno055.rst:178
msgid "IMU fusion mode using accelerometer + gyroscope (``0x08``)."
msgstr "加速度計 + ジャイロスコープを使用する IMU 融合モード（\\ ``0x08``\\ ）。"

#: ../../library/omv.bno055.rst:183
msgid "Compass fusion mode using accelerometer + magnetometer (``0x09``)."
msgstr "加速度計 + 磁力計を使用するコンパス融合モード（\\ ``0x09``\\ ）。"

#: ../../library/omv.bno055.rst:188
