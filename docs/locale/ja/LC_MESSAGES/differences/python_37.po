msgid ""
"New features include *gc.freeze()*, *gc.unfreeze()*, *gc-get_freeze_count*"
msgstr "新機能には *gc.freeze()*\\ 、\\ *gc.unfreeze()*\\ 、\\ *gc-get_freeze_count* が含まれます"

