msgstr "ファームウェアには、外部に配線されたサーマルイメージャ向けの :doc:`/library/omv.fir` ドライバが含まれています。"

#: ../../openmvcam/quickref/arduino-nano-33-ble-sense.rst:571
msgid "**MLX90621** — 16 × 4 IR array"
msgstr "**MLX90621** — 16 × 4 IR アレイ"

#: ../../openmvcam/quickref/arduino-nano-33-ble-sense.rst:572
msgid "**MLX90640** — 32 × 24 IR array"
msgstr "**MLX90640** — 32 × 24 IR アレイ"

#: ../../openmvcam/quickref/arduino-nano-33-ble-sense.rst:573
msgid "**MLX90641** — 16 × 12 IR array"
msgstr "**MLX90641** — 16 × 12 IR アレイ"

#: ../../openmvcam/quickref/arduino-nano-33-ble-sense.rst:574
msgid "**AMG8833** — 8 × 8 IR array"
msgstr "**AMG8833** — 8 × 8 IR アレイ"

#: ../../openmvcam/quickref/arduino-nano-33-ble-sense.rst:576
msgid ""
"Wire the module to the board's I²C bus and read frames with ``fir.init()`` +"
" ``fir.snapshot()``::"
msgstr ""
