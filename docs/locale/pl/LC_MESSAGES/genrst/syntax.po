#: ../../genrst/syntax.rst:46
msgid "Operators"
msgstr "Operatory"

#: ../../genrst/syntax.rst:51
msgid ""
"MicroPython allows using := to assign to the variable of a comprehension, "
"CPython raises a SyntaxError."
msgstr ""
"MicroPython pozwala używać := do przypisywania do zmiennej wyrażenia "
"listowego, CPython zgłasza SyntaxError."

#: ../../genrst/syntax.rst:53
msgid ""
"**Cause:** MicroPython is optimised for code size and doesn't check this "
"case."
msgstr ""
"**Przyczyna:** MicroPython jest zoptymalizowany pod kątem rozmiaru kodu i "
"nie sprawdza tego przypadku."

#: ../../genrst/syntax.rst:55
msgid ""
"**Workaround:** Do not rely on this behaviour if writing CPython compatible "
"code."
msgstr ""
"**Obejście:** Nie polegaj na tym zachowaniu podczas pisania kodu zgodnego z "
"CPython."

#: ../../genrst/syntax.rst:73
msgid "Spaces"
msgstr "Spacje"

#: ../../genrst/syntax.rst:78
msgid "uPy requires spaces between literal numbers and keywords, CPy doesn't"
msgstr ""
"uPy wymaga spacji między literalnymi liczbami a słowami kluczowymi, CPy nie"

#: ../../genrst/syntax.rst:107
msgid "Unicode"
msgstr "Unicode"

#: ../../genrst/syntax.rst:112
msgid "Unicode name escapes are not implemented"
msgstr "Sekwencje ucieczki nazw Unicode nie są zaimplementowane"
