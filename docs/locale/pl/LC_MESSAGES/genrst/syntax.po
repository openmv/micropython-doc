#: ../../genrst/syntax.rst:10
msgid ""
"Argument unpacking does not work if the argument being unpacked is the nth "
"or greater argument where n is the number of bits in an MP_SMALL_INT."
msgstr ""
"Rozpakowywanie argumentów nie działa, jeśli rozpakowywany argument jest "
"n-tym lub dalszym argumentem, gdzie n to liczba bitów w MP_SMALL_INT."

#: ../../genrst/syntax.rst:12
msgid ""
"**Cause:** The implementation uses an MP_SMALL_INT to flag args that need to"
" be unpacked."
msgstr ""
"**Przyczyna:** Implementacja używa MP_SMALL_INT do oznaczania argumentów "
"wymagających rozpakowania."

#: ../../genrst/syntax.rst:14
msgid "**Workaround:** Use fewer arguments."
msgstr "**Obejście:** Używaj mniejszej liczby argumentów."

