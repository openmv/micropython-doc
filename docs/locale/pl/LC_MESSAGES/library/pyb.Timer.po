msgid "Break input is disabled."
msgstr "Wejście przerwania (break) jest wyłączone."

#: ../../library/pyb.Timer.rst:275
msgid "Break input is active-low."
msgstr "Wejście przerwania (break) jest aktywne w stanie niskim."

#: ../../library/pyb.Timer.rst:280
msgid "Break input is active-high."
msgstr "Wejście przerwania (break) jest aktywne w stanie wysokim."

