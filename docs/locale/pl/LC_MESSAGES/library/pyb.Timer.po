msgstr "Konfiguruje kanał do wyjścia PWM (aktywny stan niski)."

#: ../../library/pyb.Timer.rst:297
msgid "Output-compare timing mode; no pin is driven."
msgstr ""
"Tryb synchronizacji porównania na wyjściu (output-compare); żaden pin nie "
"jest sterowany."

#: ../../library/pyb.Timer.rst:302
msgid "Output-compare active mode; the pin is made active on compare match."
msgstr ""
"Tryb aktywny porównania na wyjściu (output-compare); pin jest ustawiany jako"
" aktywny przy zgodności porównania."

#: ../../library/pyb.Timer.rst:307
msgid ""
"Output-compare inactive mode; the pin is made inactive on compare match."
msgstr ""
"Tryb nieaktywny porównania na wyjściu (output-compare); pin jest ustawiany "
"jako nieaktywny przy zgodności porównania."

#: ../../library/pyb.Timer.rst:312
msgid "Output-compare toggle mode; the pin toggles on compare match."
msgstr ""
"Tryb przełączania porównania na wyjściu (output-compare); pin przełącza się "
"przy zgodności porównania."

#: ../../library/pyb.Timer.rst:317
msgid ""
"Output-compare forced-active mode; the pin is forced active and the compare "
"match is ignored."
msgstr ""
"Tryb wymuszonej aktywności porównania na wyjściu (output-compare); pin jest "
"wymuszony jako aktywny, a zgodność porównania jest ignorowana."

#: ../../library/pyb.Timer.rst:323
msgid ""
"Output-compare forced-inactive mode; the pin is forced inactive and the "
"compare match is ignored."
msgstr ""
"Tryb wymuszonej nieaktywności porównania na wyjściu (output-compare); pin "
"jest wymuszony jako nieaktywny, a zgodność porównania jest ignorowana."

#: ../../library/pyb.Timer.rst:329
msgid "Configure the channel for input-capture mode."
msgstr ""
"Konfiguruje kanał w trybie przechwytywania na wejściu (input-capture)."

#: ../../library/pyb.Timer.rst:334
msgid "Encoder mode: the counter only changes when CH1 changes."
msgstr "Tryb enkodera: licznik zmienia się tylko wtedy, gdy zmienia się CH1."

#: ../../library/pyb.Timer.rst:339
msgid "Encoder mode: the counter only changes when CH2 changes."
msgstr "Tryb enkodera: licznik zmienia się tylko wtedy, gdy zmienia się CH2."

#: ../../library/pyb.Timer.rst:344
msgid "Encoder mode: the counter changes whenever CH1 or CH2 changes."
msgstr ""
"Tryb enkodera: licznik zmienia się za każdym razem, gdy zmienia się CH1 lub "
"CH2."

