msgstr "Tryb bez fuzji, akcelerometr + żyroskop (\\ ``0x05``\\ )."

#: ../../library/omv.bno055.rst:168
msgid "Magnetometer + gyroscope non-fusion mode (``0x06``)."
msgstr "Tryb bez fuzji, magnetometr + żyroskop (\\ ``0x06``\\ )."

