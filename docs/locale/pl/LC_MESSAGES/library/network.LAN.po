msgstr ""
"Układ PHY Ethernet Microchip KSZ8081 10/100. Tylko port mimxrt; domyślny w "
"OpenMV Cam RT1062."

#: ../../library/network.LAN.rst:164
msgid "Texas Instruments DP83867 gigabit Ethernet PHY. mimxrt port only."
msgstr ""
