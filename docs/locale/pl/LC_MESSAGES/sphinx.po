msgid "Made with the <a href=\"https://shibuya.lepture.com\">Shibuya theme</a>."
msgstr ""
"Wykonano z motywem <a href=\"https://shibuya.lepture.com\">Shibuya "
"theme</a>."

msgid "MicroPython on GitHub"
msgstr "MicroPython na GitHub"

msgid "Minimal HTTP server — routes, sessions, login, SSE, and WebSockets."
msgstr "Minimalny serwer HTTP — trasy, sesje, logowanie, SSE i WebSockets."

msgid "Monochrome global-shutter sensor for fast-motion capture."
msgstr ""
"Monochromatyczny sensor global-shutter do rejestrowania szybkiego ruchu."

msgid "More actions"
msgstr "Więcej akcji"

msgid "More resources"
msgstr "Więcej zasobów"

msgid "NXP i.MX RT1062 Cortex-M7 at 600 MHz with 32 MB external SDRAM."
msgstr ""
"NXP i.MX RT1062 Cortex-M7 taktowany 600 MHz z 32 MB zewnętrznego SDRAM."

