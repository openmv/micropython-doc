#: ../../openmvcam/shields/battery-shield.rst:1
msgid "PWR in"
msgstr "PWR in"

#: ../../openmvcam/shields/battery-shield.rst:1
msgid "6–36 V wide input on the terminal block (reverse-voltage tolerant)"
msgstr ""
"Szerokie wejście 6–36 V na listwie zaciskowej (odporne na odwrotną "
"polaryzację napięcia)"

#: ../../openmvcam/shields/battery-shield.rst:1
msgid "RAW out"
msgstr "RAW out"

#: ../../openmvcam/shields/battery-shield.rst:1
msgid "3.5 V at up to 800 mA — direct from the barrel jack"
msgstr "3.5 V przy maksymalnie 800 mA — bezpośrednio z gniazda DC"

#: ../../openmvcam/shields/battery-shield.rst:1
msgid "VIN out"
msgstr "VIN out"

#: ../../openmvcam/shields/battery-shield.rst:1
