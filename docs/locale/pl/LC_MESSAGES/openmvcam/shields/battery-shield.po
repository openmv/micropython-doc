msgstr ""
"Wejście ADC 0–6 V (z konwersją poziomu do 0–2.8 V na P6) do monitorowania "
"napięcia gniazda DC"

#: ../../openmvcam/shields/battery-shield.rst:1
msgid "BARREL in"
msgstr "BARREL in"

#: ../../openmvcam/shields/battery-shield.rst:1
