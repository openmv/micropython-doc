msgstr "P4"

#: ../../openmvcam/shields/qwiic-shield.rst:1
msgid "Qwiic SCL — I²C clock to both Qwiic connectors"
msgstr "Qwiic SCL — zegar I²C do obu złączy Qwiic"

#: ../../openmvcam/shields/qwiic-shield.rst:1
msgid "P5"
msgstr "P5"

#: ../../openmvcam/shields/qwiic-shield.rst:1
msgid "Qwiic SDA — I²C data to both Qwiic connectors"
msgstr "Qwiic SDA — dane I²C do obu złączy Qwiic"

#: ../../openmvcam/shields/qwiic-shield.rst:1
msgid "3.3V rail"
msgstr "Szyna 3.3V"

#: ../../openmvcam/shields/qwiic-shield.rst:1
