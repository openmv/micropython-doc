msgstr "Dwie redukcje również produkują indeksy:"

#: ../../openmvcam/tutorial/numpy/math/selection.rst:62
msgid ""
":func:`~numpy.argmin` / :func:`~numpy.argmax` -- index of the smallest / "
"largest element."
msgstr ""
":func:`~numpy.argmin` / :func:`~numpy.argmax` -- indeks najmniejszego / "
"największego elementu."

#: ../../openmvcam/tutorial/numpy/math/selection.rst:65
msgid ""
