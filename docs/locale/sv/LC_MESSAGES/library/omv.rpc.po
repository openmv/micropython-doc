msgstr ""
"Master- och slavadresserna måste matcha. Externa pull-up-motstånd krävs på "
"SCL och SDA, och båda enheterna måste dela en gemensam jord."

#: ../../library/omv.rpc.rst:261
msgid "class rpc_i2c_slave -- I2C Slave Interface"
msgstr "class rpc_i2c_slave -- I2C-slavgränssnitt"

#: ../../library/omv.rpc.rst:263
msgid "Be controlled by another ``rpc`` device over I2C."
msgstr "Styras av en annan ``rpc``\\ -enhet över I2C."

#: ../../library/omv.rpc.rst:267
msgid "``slave_addr`` -- 7-bit I2C address this slave responds to."
msgstr "``slave_addr`` -- 7-bitars I2C-adress som denna slav svarar på."

#: ../../library/omv.rpc.rst:272
msgid "class rpc_spi_master -- SPI Master Interface"
msgstr "class rpc_spi_master -- SPI-mastergränssnitt"

#: ../../library/omv.rpc.rst:274
msgid "Control another ``rpc`` device over SPI."
msgstr "Styr en annan ``rpc``\\ -enhet över SPI."

#: ../../library/omv.rpc.rst:278
msgid "``cs_pin`` -- chip-select pin name."
msgstr "``cs_pin`` -- namn på chip-select-stiftet."

#: ../../library/omv.rpc.rst:279
msgid "``freq`` -- SPI bus clock frequency in Hz."
msgstr "``freq`` -- SPI-bussens klockfrekvens i Hz."

#: ../../library/omv.rpc.rst:280 ../../library/omv.rpc.rst:296
msgid "``clk_polarity`` -- idle clock level (0 or 1)."
msgstr "``clk_polarity`` -- klocknivå i viloläge (0 eller 1)."

#: ../../library/omv.rpc.rst:281 ../../library/omv.rpc.rst:297
msgid ""
"``clk_phase`` -- sample data on the first (0) or second (1) clock edge."
msgstr ""
"``clk_phase`` -- sampla data på den första (0) eller andra (1) klockflanken."

#: ../../library/omv.rpc.rst:282 ../../library/omv.rpc.rst:298
msgid "``spi_bus`` -- SPI peripheral number."
msgstr "``spi_bus`` -- SPI-kringutrustningens nummer."

#: ../../library/omv.rpc.rst:284
msgid ""
"Master and slave settings must match. Connect CS, SCLK, MOSI, MISO directly."
" Both devices must share a common ground."
msgstr ""
"Master- och slavinställningarna måste matcha. Anslut CS, SCLK, MOSI, MISO "
"direkt. Båda enheterna måste dela en gemensam jord."

#: ../../library/omv.rpc.rst:289
msgid "class rpc_spi_slave -- SPI Slave Interface"
msgstr "class rpc_spi_slave -- SPI-slavgränssnitt"

#: ../../library/omv.rpc.rst:291
msgid "Be controlled by another ``rpc`` device over SPI."
msgstr "Styras av en annan ``rpc``\\ -enhet över SPI."

#: ../../library/omv.rpc.rst:295
msgid "``cs_pin`` -- chip-select input pin name."
msgstr "``cs_pin`` -- namn på chip-select-ingångsstiftet."

#: ../../library/omv.rpc.rst:302
msgid "class rpc_uart_master -- UART Master Interface"
msgstr "class rpc_uart_master -- UART-mastergränssnitt"

#: ../../library/omv.rpc.rst:304
msgid "Control another ``rpc`` device over Async Serial (UART)."
msgstr ""
"Styr en annan ``rpc``\\ -enhet över asynkron seriell kommunikation (UART)."

#: ../../library/omv.rpc.rst:308 ../../library/omv.rpc.rst:322
msgid "``baudrate`` -- serial baud rate."
msgstr "``baudrate`` -- seriell baudhastighet."

#: ../../library/omv.rpc.rst:309 ../../library/omv.rpc.rst:323
msgid "``uart_port`` -- UART peripheral number."
msgstr "``uart_port`` -- UART-kringutrustningens nummer."

#: ../../library/omv.rpc.rst:311
msgid ""
"Master and slave baud rates must match. Connect master TX to slave RX and "
"master RX to slave TX. Both devices must share a common ground."
msgstr ""
"Master- och slavbaudhastigheterna måste matcha. Anslut masterns TX till "
"slavens RX och masterns RX till slavens TX. Båda enheterna måste dela en "
"gemensam jord."

