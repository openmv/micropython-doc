msgstr "Endast VCP (Virtual COM Port)."

#: ../../library/pyb.rst:287
msgid "``'MSC'``"
msgstr "``'MSC'``"

#: ../../library/pyb.rst:288
msgid "MSC (USB mass storage class) only."
msgstr "Endast MSC (USB mass storage class)."

#: ../../library/pyb.rst:289
msgid "``'VCP+MSC'``"
msgstr "``'VCP+MSC'``"

#: ../../library/pyb.rst:290
msgid "VCP and MSC."
msgstr "VCP och MSC."

#: ../../library/pyb.rst:291
msgid "``'VCP+HID'``"
msgstr "``'VCP+HID'``"

