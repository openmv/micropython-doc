#: ../../library/pyb.rst:260
msgid "Return a 30-bit hardware generated random number."
msgstr "Returnera ett 30-bitars hårdvarugenererat slumptal."

#: ../../library/pyb.rst:264
msgid "Sync all file systems."
msgstr "Synkronisera alla filsystem."

#: ../../library/pyb.rst:268
msgid ""
"Returns a string of 12 bytes (96 bits), which is the unique ID of the MCU."
msgstr ""
"Returnerar en sträng på 12 byte (96 bitar), vilket är MCU:ns unika ID."

#: ../../library/pyb.rst:272
