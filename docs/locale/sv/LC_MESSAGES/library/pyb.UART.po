msgstr "UART-objekt kan skapas och initieras med::"

#: ../../library/pyb.UART.rst:22
msgid ""
"Bits can be 7, 8 or 9.  Parity can be None, 0 (even) or 1 (odd).  Stop can "
"be 1 or 2."
msgstr ""
"Bits kan vara 7, 8 eller 9. Parity kan vara None, 0 (jämn) eller 1 (udda). "
"Stop kan vara 1 eller 2."

#: ../../library/pyb.UART.rst:24 ../../library/pyb.UART.rst:115
msgid ""
"*Note:* with parity=None, only 8 and 9 bits are supported.  With parity "
"enabled, only 7 and 8 bits are supported."
msgstr ""
"*Obs:* med parity=None stöds endast 8 och 9 bitar. Med paritet aktiverad "
"stöds endast 7 och 8 bitar."

