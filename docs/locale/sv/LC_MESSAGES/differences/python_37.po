msgid ""
"New features include *gc.freeze()*, *gc.unfreeze()*, *gc-get_freeze_count*"
msgstr ""
"Nya funktioner inkluderar *gc.freeze()*\\ , *gc.unfreeze()*\\ , *gc-"
"get_freeze_count*"

