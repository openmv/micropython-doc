msgstr ""
"Ta bort −128-förskjutningen när Y skickas till ``yuv_to_*`` (\\ "
":ref:`yuv_to_*-ändringen <v3_7_0_yuv>`\\ )."

#: ../../changelog/firmware/v3.7.0.rst:193
msgid "All other scripts run unchanged."
msgstr "Alla andra skript körs oförändrade."
