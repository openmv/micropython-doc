msgstr ""
"Ansiktsdetektering i realtid, AprilTag-spårning, QR-skanning och YOLO. Allt "
"på enheten i ren MicroPython. Ingen värddator, inget moln."

msgid ""
"Loaded from <code>/rom/blazeface_front_128.tflite</code> — pre-quantised, no"
" download needed."
msgstr ""
"Laddas från <code>/rom/blazeface_front_128.tflite</code> — förkvantiserad, "
"ingen nedladdning behövs."

msgid ""
"Loaded from <code>/rom/hand_landmarks_full_224.tflite</code> — running "
"standalone here, without palm detection upstream."
msgstr ""
"Laddas från <code>/rom/hand_landmarks_full_224.tflite</code> — körs "
"fristående här, utan handflatedetektering uppströms."

msgid ""
"Loaded from <code>/rom/yolov8n_192.tflite</code> — no SD card or download "
"needed."
msgstr ""
"Laddas från <code>/rom/yolov8n_192.tflite</code> — inget SD-kort eller "
"nedladdning behövs."

