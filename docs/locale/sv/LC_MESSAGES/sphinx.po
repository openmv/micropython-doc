msgstr "Hårdvara"

msgid ""
"Hardware, cameras, image processing, ndarrays, ML, multitasking, networking,"
" web servers, and Bluetooth — all from MicroPython."
msgstr ""
"Hårdvara, kameror, bildbehandling, ndarrays, ML, multitasking, nätverk, "
"webbservrar och Bluetooth — allt från MicroPython."

