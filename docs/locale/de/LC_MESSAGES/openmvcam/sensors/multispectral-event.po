msgstr "320x320-Event-Sensor, >140 dB Dynamikbereich, 375 Hz+ Histogramme"

#: ../../openmvcam/sensors/multispectral-event.rst:22
msgid "PAG7936 colour: 1280x800 @ 120 FPS, 640x400 @ 240 FPS"
msgstr "PAG7936-Farbe: 1280x800 @ 120 FPS, 640x400 @ 240 FPS"

