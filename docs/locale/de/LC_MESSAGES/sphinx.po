msgid "1-MP global-shutter colour + FLIR Lepton thermal on one module."
msgstr ""
"1-MP-Global-Shutter-Farbe + FLIR Lepton Wärmebildgebung auf einem Modul."

msgid "1.8–5.5V battery input via a DC barrel jack."
msgstr "1,8–5,5-V-Batterieeingang über einen DC-Hohlstecker."

msgid "10 Mb/s differential serial for industrial buses."
msgstr "10-Mb/s-Differenzielle Serielle Schnittstelle für Industriebusse."

msgid "10/100 Ethernet with Power-over-Ethernet."
msgstr "10/100-Ethernet mit Power-over-Ethernet."

msgid "2.3\" SPI LCD with capacitive multi-touch and Qwiic."
msgstr "2,3\" SPI-LCD mit kapazitivem Multi-Touch und Qwiic."

msgid "5MP HDR sensor — high dynamic range for tough lighting."
msgstr ""
"5-MP-HDR-Sensor — hoher Dynamikumfang für schwierige Lichtverhältnisse."

msgid "5MP rolling-shutter colour + FLIR Lepton thermal on one module."
msgstr ""
"5-MP-Rolling-Shutter-Farbe + FLIR Lepton Wärmebildgebung auf einem Modul."

msgid "6µA standby motion trigger plus white and 850 nm IR."
msgstr "6-µA-Standby-Bewegungsauslöser plus weißes und 850-nm-IR-Licht."

msgid "8 Mb/s CAN-FD plus 1 Mb/s RS-232 in one shield."
msgstr "8 Mb/s CAN-FD plus 1 Mb/s RS-232 in einem Shield."

msgid ""
"<code>find_blobs</code> returns connected pixel regions matching one or more"
" LAB thresholds."
msgstr ""
"<code>find_blobs</code> gibt zusammenhängende Pixelbereiche zurück, die "
"einem oder mehreren LAB-Schwellenwerten entsprechen."

msgid ""
"<code>ml.utils.draw_skeleton</code> draws all 21 joints and connections in "
"one call."
msgstr ""
"<code>ml.utils.draw_skeleton</code> zeichnet alle 21 Gelenke und "
"Verbindungen in einem einzigen Aufruf."

msgid ""
"<code>pixels_threshold</code> filters tiny detections; "
"<code>merge=True</code> joins overlapping blobs."
msgstr ""
"<code>pixels_threshold</code> filtert winzige Erkennungen; "
"<code>merge=True</code> verbindet überlappende Bereiche."

