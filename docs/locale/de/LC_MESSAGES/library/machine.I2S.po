#: ../../library/machine.I2S.rst:99
msgid "``mode`` specifies receive or transmit"
msgstr "``mode`` legt Empfangen oder Senden fest"

#: ../../library/machine.I2S.rst:100
msgid "``bits`` specifies sample size (bits), 16 or 32"
msgstr "``bits`` legt die Sample-Größe (Bits) fest, 16 oder 32"

#: ../../library/machine.I2S.rst:101
