msgstr "Interner 1,21-V-Spannungsreferenzkanal (nominal) (``VREFINT``)."

#: ../../library/machine.ADC.rst:74
msgid "Internal die-temperature sensor channel."
msgstr "Interner Die-Temperatursensorkanal."

#: ../../library/machine.ADC.rst:79
