msgstr "логическое или целое ``0``/``1``/``2``"

#: ../../openmvcam/tutorial/tools/ide/settings-editor/value-controls.rst:14
#: ../../openmvcam/tutorial/tools/ide/settings-editor/value-controls.rst:51
msgid "combobox"
msgstr "combobox"

#: ../../openmvcam/tutorial/tools/ide/settings-editor/value-controls.rst:14
#: ../../openmvcam/tutorial/tools/ide/settings-editor/value-controls.rst:15
msgid "the chosen value, or its index"
msgstr "выбранное значение или его индекс"

#: ../../openmvcam/tutorial/tools/ide/settings-editor/value-controls.rst:15
#: ../../openmvcam/tutorial/tools/ide/settings-editor/value-controls.rst:86
msgid "radio"
msgstr "radio"

#: ../../openmvcam/tutorial/tools/ide/settings-editor/value-controls.rst:16
#: ../../openmvcam/tutorial/tools/ide/settings-editor/value-controls.rst:119
msgid "spinbox"
msgstr "spinbox"

#: ../../openmvcam/tutorial/tools/ide/settings-editor/value-controls.rst:16
#: ../../openmvcam/tutorial/tools/ide/settings-editor/value-controls.rst:18
msgid "integer"
msgstr "целое"

#: ../../openmvcam/tutorial/tools/ide/settings-editor/value-controls.rst:17
#: ../../openmvcam/tutorial/tools/ide/settings-editor/value-controls.rst:160
msgid "doublespinbox"
msgstr "doublespinbox"

#: ../../openmvcam/tutorial/tools/ide/settings-editor/value-controls.rst:17
msgid "number (floating point)"
msgstr "число (с плавающей точкой)"

#: ../../openmvcam/tutorial/tools/ide/settings-editor/value-controls.rst:18
#: ../../openmvcam/tutorial/tools/ide/settings-editor/value-controls.rst:202
msgid "slider"
msgstr "slider"

#: ../../openmvcam/tutorial/tools/ide/settings-editor/value-controls.rst:19
#: ../../openmvcam/tutorial/tools/ide/settings-editor/value-controls.rst:241
