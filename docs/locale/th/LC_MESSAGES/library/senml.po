msgid "``\"%EL\"`` -- remaining battery level as a percentage."
msgstr "``\"%EL\"`` -- ระดับแบตเตอรี่คงเหลือเป็นเปอร์เซ็นต์"

#: ../../library/senml.rst:473
msgid "``\"EL\"`` -- remaining battery level in seconds."
msgstr "``\"EL\"`` -- ระดับแบตเตอรี่คงเหลือเป็นวินาที"

#: ../../library/senml.rst:478
msgid "``\"1/s\"`` -- event rate per second."
