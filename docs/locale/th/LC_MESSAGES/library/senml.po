#: ../../library/senml.rst:483
msgid "``\"1/min\"`` -- event rate per minute."
msgstr "``\"1/min\"`` -- อัตราเหตุการณ์ต่อนาที"

#: ../../library/senml.rst:488
msgid "``\"beat/min\"`` -- beats per minute."
msgstr "``\"beat/min\"`` -- ครั้งต่อนาที"

#: ../../library/senml.rst:493
msgid "``\"beats\"`` -- beats."
msgstr "``\"beats\"`` -- ครั้ง"

#: ../../library/senml.rst:498
msgid "``\"S/m\"`` -- siemens per metre (electrical conductivity)."
msgstr "``\"S/m\"`` -- ซีเมนส์ต่อเมตร (การนำไฟฟ้า)"
