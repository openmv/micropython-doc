#: ../../reference/asm_thumb2_arith.rst:2
msgid "Arithmetic instructions"
msgstr "คำสั่งคำนวณ"

#: ../../reference/asm_thumb2_arith.rst:5
msgid "Document conventions"
msgstr "รูปแบบของเอกสาร"

#: ../../reference/asm_thumb2_arith.rst:7
msgid ""
"Notation: ``Rd, Rm, Rn`` denote ARM registers R0-R7. ``immN`` denotes an "
"immediate value having a width of N bits e.g. ``imm8``, ``imm3``. ``carry`` "
"denotes the carry condition flag, ``not(carry)`` denotes its complement. In "
"the case of instructions with more than one register argument, it is "
"permissible for some to be identical. For example the following will add the"
" contents of R0 to itself, placing the result in R0:"
msgstr ""
"สัญกรณ์: ``Rd, Rm, Rn`` แทน ARM registers R0-R7 ``immN`` "
"แทนค่าทันทีที่มีความกว้าง N บิต เช่น ``imm8``\\ , ``imm3`` ``carry`` "
"แทนแฟล็กเงื่อนไข carry, ``not(carry)`` แทนส่วนเติมเต็มของมัน "
"ในกรณีของคำสั่งที่มีอาร์กิวเมนต์ register มากกว่าหนึ่งตัว "
"บางตัวอาจเหมือนกันได้ ตัวอย่างเช่น สิ่งต่อไปนี้จะบวกเนื้อหาของ R0 "
"เข้ากับตัวเอง โดยวางผลลัพธ์ใน R0:"

#: ../../reference/asm_thumb2_arith.rst:13
msgid "add(r0, r0, r0)"
msgstr "add(r0, r0, r0)"

#: ../../reference/asm_thumb2_arith.rst:15
msgid ""
"Arithmetic instructions affect the condition flags except where stated."
msgstr "คำสั่งคำนวณส่งผลต่อแฟล็กเงื่อนไข ยกเว้นเมื่อระบุไว้"

#: ../../reference/asm_thumb2_arith.rst:18
msgid "Addition"
msgstr "การบวก"

#: ../../reference/asm_thumb2_arith.rst:20
msgid "add(Rdn, imm8) ``Rdn = Rdn + imm8``"
msgstr "add(Rdn, imm8) ``Rdn = Rdn + imm8``"

#: ../../reference/asm_thumb2_arith.rst:21
msgid "add(Rd, Rn, imm3) ``Rd = Rn + imm3``"
msgstr "add(Rd, Rn, imm3) ``Rd = Rn + imm3``"

#: ../../reference/asm_thumb2_arith.rst:22
msgid "add(Rd, Rn, Rm) ``Rd = Rn + Rm``"
msgstr "add(Rd, Rn, Rm) ``Rd = Rn + Rm``"

#: ../../reference/asm_thumb2_arith.rst:23
msgid "adc(Rd, Rn) ``Rd = Rd + Rn + carry``"
msgstr "adc(Rd, Rn) ``Rd = Rd + Rn + carry``"

#: ../../reference/asm_thumb2_arith.rst:26
msgid "Subtraction"
msgstr "การลบ"

#: ../../reference/asm_thumb2_arith.rst:28
msgid "sub(Rdn, imm8) ``Rdn = Rdn - imm8``"
msgstr "sub(Rdn, imm8) ``Rdn = Rdn - imm8``"

#: ../../reference/asm_thumb2_arith.rst:29
msgid "sub(Rd, Rn, imm3) ``Rd = Rn - imm3``"
msgstr "sub(Rd, Rn, imm3) ``Rd = Rn - imm3``"

#: ../../reference/asm_thumb2_arith.rst:30
msgid "sub(Rd, Rn, Rm) ``Rd = Rn - Rm``"
msgstr "sub(Rd, Rn, Rm) ``Rd = Rn - Rm``"

#: ../../reference/asm_thumb2_arith.rst:31
msgid "sbc(Rd, Rn) ``Rd = Rd - Rn - not(carry)``"
msgstr "sbc(Rd, Rn) ``Rd = Rd - Rn - not(carry)``"

#: ../../reference/asm_thumb2_arith.rst:34
msgid "Negation"
msgstr "การนีเกต"

#: ../../reference/asm_thumb2_arith.rst:36
msgid "neg(Rd, Rn) ``Rd = -Rn``"
msgstr "neg(Rd, Rn) ``Rd = -Rn``"

#: ../../reference/asm_thumb2_arith.rst:39
msgid "Multiplication and division"
msgstr "การคูณและการหาร"

#: ../../reference/asm_thumb2_arith.rst:41
msgid "mul(Rd, Rn) ``Rd = Rd * Rn``"
msgstr "mul(Rd, Rn) ``Rd = Rd * Rn``"

#: ../../reference/asm_thumb2_arith.rst:43
msgid ""
"This produces a 32 bit result with overflow lost. The result may be treated "
"as signed or unsigned according to the definition of the operands."
msgstr ""
"ให้ผลลัพธ์ 32 บิตโดยสูญเสีย overflow "
"ผลลัพธ์อาจถือเป็นค่าที่มีเครื่องหมายหรือไม่มีเครื่องหมายตามนิยามของตัวถูกดำเนินการ"

#: ../../reference/asm_thumb2_arith.rst:46
msgid "sdiv(Rd, Rn, Rm) ``Rd = Rn / Rm``"
msgstr "sdiv(Rd, Rn, Rm) ``Rd = Rn / Rm``"

#: ../../reference/asm_thumb2_arith.rst:47
msgid "udiv(Rd, Rn, Rm) ``Rd = Rn / Rm``"
msgstr "udiv(Rd, Rn, Rm) ``Rd = Rn / Rm``"

#: ../../reference/asm_thumb2_arith.rst:49
msgid ""
"These functions perform signed and unsigned division respectively. Condition"
" flags are not affected."
msgstr ""
"ฟังก์ชันเหล่านี้ทำการหารแบบมีเครื่องหมายและไม่มีเครื่องหมายตามลำดับ "
"แฟล็กเงื่อนไขไม่ได้รับผลกระทบ"
