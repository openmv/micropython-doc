msgstr "`gc <https://docs.python.org/3/whatsnew/3.7.html#gc>`_"

#: ../../differences/python_37.rst:86
msgid ""
"New features include *gc.freeze()*, *gc.unfreeze()*, *gc-get_freeze_count*"
msgstr ""
"ฟีเจอร์ใหม่ได้แก่ *gc.freeze()*\\ , *gc.unfreeze()*\\ , *gc-"
"get_freeze_count*"

