msgstr "**การเปลี่ยนแปลงเบ็ดเตล็ด**"

#: ../../differences/python_35.rst:37
msgid "`PEP 441 <https://www.python.org/dev/peps/pep-0441/>`_"
msgstr "`PEP 441 <https://www.python.org/dev/peps/pep-0441/>`_"

#: ../../differences/python_35.rst:37
msgid "Improved Python zip application support"
msgstr "การปรับปรุงการรองรับแอปพลิเคชัน Python zip"

#: ../../differences/python_35.rst:39
msgid "`PEP 486 <https://www.python.org/dev/peps/pep-0486/>`_"
msgstr "`PEP 486 <https://www.python.org/dev/peps/pep-0486/>`_"

