msgid "One of:"
msgstr "Een van:"

#: ../../library/ubluepy.rst:87
msgid "``int`` --- a 16-bit numeric UUID (``UUID(0x180A)``)."
msgstr "``int`` --- een 16-bits numerieke UUID (\\ ``UUID(0x180A)``\\ )."

#: ../../library/ubluepy.rst:88
msgid ""
"6-character ``\"0xXXXX\"`` string --- a 16-bit UUID, e.g. "
"``UUID(\"0x181A\")``."
msgstr ""
"Een 6-tekenstring ``\"0xXXXX\"`` --- een 16-bits UUID, bijv. "
"``UUID(\"0x181A\")``\\ ."

#: ../../library/ubluepy.rst:90
msgid ""
"36-character ``\"xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx\"`` string --- a full "
"128-bit UUID. The vendor-specific portion is registered with the SoftDevice "
"on construction."
msgstr ""
"Een 36-tekenstring ``\"xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx\"`` --- een "
"volledige 128-bits UUID. Het leverancierspecifieke deel wordt bij "
"constructie bij de SoftDevice geregistreerd."

