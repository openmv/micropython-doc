msgstr "AHB-bus, kerngeheugen en DMA-frequentie"

#: ../../library/pyb.rst:144
msgid "``pclk1``"
msgstr "``pclk1``"

#: ../../library/pyb.rst:145
msgid "APB1 bus frequency"
msgstr "APB1-busfrequentie"

