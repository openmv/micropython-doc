msgstr "relatieve tolerantie op het nulpunt (standaard ``rtolerance``\\ )."

#: ../../library/omv.ulab.scipy.optimize.rst:66
msgid "maximum number of iterations (default ``50``)."
msgstr "maximaal aantal iteraties (standaard ``50``\\ )."
