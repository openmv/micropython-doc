msgid ""
"New features include *gc.freeze()*, *gc.unfreeze()*, *gc-get_freeze_count*"
msgstr ""
"Nieuwe functies zijn onder andere *gc.freeze()*\\ , *gc.unfreeze()*\\ , *gc-"
"get_freeze_count*"

