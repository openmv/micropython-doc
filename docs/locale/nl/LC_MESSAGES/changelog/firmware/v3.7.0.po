msgstr ""
"Laat de −128-bias vallen bij het doorgeven van Y aan ``yuv_to_*`` (\\ "
":ref:`de yuv_to_*-wijziging <v3_7_0_yuv>`\\ )."

#: ../../changelog/firmware/v3.7.0.rst:193
msgid "All other scripts run unchanged."
msgstr "Alle andere scripts draaien ongewijzigd."
