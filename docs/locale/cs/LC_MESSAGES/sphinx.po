msgstr "Co je nového"

msgid ""
"Where MicroPython diverges from standard Python — modules, builtins, and "
"syntax."
msgstr ""
"Kde se MicroPython odchyluje od standardního Python — moduly, vestavěné "
"funkce a syntaxe."

msgid "Wi-Fi, Ethernet, and sockets for IoT and remote communication."
msgstr "Wi-Fi, Ethernet a sokety pro IoT a vzdálenou komunikaci."

msgid "YOLOv8 person tracking"
msgstr "Sledování osob pomocí YOLOv8"
