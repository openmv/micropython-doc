#: ../../library/pyb.rst:140
msgid "``sysclk``"
msgstr "``sysclk``"

#: ../../library/pyb.rst:141
msgid "CPU frequency"
msgstr "Frekvence CPU"

#: ../../library/pyb.rst:142
msgid "``hclk``"
msgstr "``hclk``"

#: ../../library/pyb.rst:143
msgid "AHB bus, core memory and DMA frequency"
msgstr "Frekvence sběrnice AHB, jádrové paměti a DMA"

#: ../../library/pyb.rst:144
msgid "``pclk1``"
msgstr "``pclk1``"

#: ../../library/pyb.rst:145
msgid "APB1 bus frequency"
msgstr "Frekvence sběrnice APB1"

#: ../../library/pyb.rst:146
