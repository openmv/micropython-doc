msgstr "``baudrate`` -- sériová přenosová rychlost (baud rate)."

#: ../../library/omv.rpc.rst:309 ../../library/omv.rpc.rst:323
msgid "``uart_port`` -- UART peripheral number."
msgstr "``uart_port`` -- číslo periferie UART."

#: ../../library/omv.rpc.rst:311
msgid ""
"Master and slave baud rates must match. Connect master TX to slave RX and "
"master RX to slave TX. Both devices must share a common ground."
msgstr ""
"Přenosové rychlosti master a slave se musí shodovat. Připojte TX master k RX"
" slave a RX master k TX slave. Obě zařízení musí sdílet společnou zem."

