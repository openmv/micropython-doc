msgstr "Vyžadovat ochranu proti man-in-the-middle."

#: ../../library/aioble.rst:399
msgid "*io*"
msgstr "*io*"

#: ../../library/aioble.rst:400
msgid "IO capability constant (e.g. ``3`` for no input/output)."
msgstr "Konstanta schopnosti IO (např. ``3`` pro žádný vstup/výstup)."

#: ../../library/aioble.rst:403
