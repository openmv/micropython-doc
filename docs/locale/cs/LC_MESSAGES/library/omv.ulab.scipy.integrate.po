#: ../../library/omv.ulab.scipy.integrate.rst:57
#: ../../library/omv.ulab.scipy.integrate.rst:72
msgid "callable taking a single ``float`` and returning a ``float``."
msgstr "volatelný objekt přijímající jediný ``float`` a vracející ``float``\\ ."

#: ../../library/omv.ulab.scipy.integrate.rst:28
#: ../../library/omv.ulab.scipy.integrate.rst:44
#: ../../library/omv.ulab.scipy.integrate.rst:58
msgid "lower integration limit."
msgstr "dolní mez integrace."

#: ../../library/omv.ulab.scipy.integrate.rst:29
#: ../../library/omv.ulab.scipy.integrate.rst:45
#: ../../library/omv.ulab.scipy.integrate.rst:59
msgid "upper integration limit."
msgstr "horní mez integrace."

#: ../../library/omv.ulab.scipy.integrate.rst:30
msgid "order of integration (default ``5``)."
msgstr "řád integrace (výchozí ``5``\\ )."

#: ../../library/omv.ulab.scipy.integrate.rst:31
#: ../../library/omv.ulab.scipy.integrate.rst:47
#: ../../library/omv.ulab.scipy.integrate.rst:61
