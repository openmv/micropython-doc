#: ../../genrst/syntax.rst:46
msgid "Operators"
msgstr "Operadores"

#: ../../genrst/syntax.rst:51
msgid ""
"MicroPython allows using := to assign to the variable of a comprehension, "
"CPython raises a SyntaxError."
msgstr ""
"MicroPython permite usar := para atribuir à variável de uma compreensão; "
"CPython lança um SyntaxError."

#: ../../genrst/syntax.rst:53
msgid ""
"**Cause:** MicroPython is optimised for code size and doesn't check this "
"case."
msgstr ""
"**Causa:** MicroPython é otimizado para tamanho de código e não verifica "
"este caso."

#: ../../genrst/syntax.rst:55
msgid ""
"**Workaround:** Do not rely on this behaviour if writing CPython compatible "
"code."
msgstr ""
"**Solução alternativa:** Não dependa desse comportamento ao escrever código "
"compatível com CPython."

#: ../../genrst/syntax.rst:73
msgid "Spaces"
msgstr "Espaços"

#: ../../genrst/syntax.rst:78
msgid "uPy requires spaces between literal numbers and keywords, CPy doesn't"
msgstr ""
"uPy exige espaços entre números literais e palavras-chave; CPy não exige"

#: ../../genrst/syntax.rst:107
msgid "Unicode"
msgstr "Unicode"

#: ../../genrst/syntax.rst:112
msgid "Unicode name escapes are not implemented"
msgstr "Sequências de escape de nome Unicode não estão implementadas"
