msgstr "``sysclk``"

#: ../../library/pyb.rst:141
msgid "CPU frequency"
msgstr "Frequência da CPU"

#: ../../library/pyb.rst:142
msgid "``hclk``"
msgstr "``hclk``"

#: ../../library/pyb.rst:143
msgid "AHB bus, core memory and DMA frequency"
msgstr "Frequência do barramento AHB, da memória do núcleo e do DMA"

#: ../../library/pyb.rst:144
msgid "``pclk1``"
msgstr "``pclk1``"

#: ../../library/pyb.rst:145
msgid "APB1 bus frequency"
msgstr "Frequência do barramento APB1"

#: ../../library/pyb.rst:146
