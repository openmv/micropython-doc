#: ../../library/pyb.rst:260
msgid "Return a 30-bit hardware generated random number."
msgstr "Retorna um número aleatório gerado por hardware de 30 bits."

#: ../../library/pyb.rst:264
msgid "Sync all file systems."
msgstr "Sincroniza todos os sistemas de arquivos."

#: ../../library/pyb.rst:268
msgid ""
"Returns a string of 12 bytes (96 bits), which is the unique ID of the MCU."
msgstr "Retorna uma string de 12 bytes (96 bits), que é o ID único do MCU."

#: ../../library/pyb.rst:272
msgid "If called with no arguments, return the current USB mode as a string."
msgstr "Se chamada sem argumentos, retorna o modo USB atual como uma string."

#: ../../library/pyb.rst:274
