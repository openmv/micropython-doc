msgstr "Lê o nível do canal vermelho como um valor sem sinal de 16 bits."

#: ../../library/omv.apds9960.rst:106
msgid "Read the green-channel level as a 16-bit unsigned value."
msgstr "Lê o nível do canal verde como um valor sem sinal de 16 bits."

#: ../../library/omv.apds9960.rst:110
