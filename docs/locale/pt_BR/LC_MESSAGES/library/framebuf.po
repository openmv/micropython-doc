msgid "Pixel layout"
msgstr "Layout de pixel"

#: ../../library/framebuf.rst:184
msgid "``MONO_VLSB``"
msgstr "``MONO_VLSB``"

#: ../../library/framebuf.rst:185 ../../library/framebuf.rst:190
#: ../../library/framebuf.rst:194
msgid "0.125"
msgstr "0.125"

#: ../../library/framebuf.rst:186
msgid ""
"Monochrome (1-bit). Each byte holds 8 vertically-stacked pixels with bit 0 "
"nearest the top. Rows of 8 pixels advance left-to-right across the buffer, "
"then wrap to the next 8-pixel row."
msgstr ""
"Monocromático (1 bit). Cada byte armazena 8 pixels empilhados verticalmente,"
" com o bit 0 mais próximo do topo. Linhas de 8 pixels avançam da esquerda "
"para a direita pelo buffer e então passam para a próxima linha de 8 pixels."

#: ../../library/framebuf.rst:189
msgid "``MONO_HLSB``"
msgstr "``MONO_HLSB``"

#: ../../library/framebuf.rst:191
msgid ""
"Monochrome (1-bit). Each byte holds 8 horizontal pixels with bit 7 leftmost."
" Rows advance one pixel at a time vertically."
msgstr ""
"Monocromático (1 bit). Cada byte armazena 8 pixels horizontais, com o bit 7 "
"mais à esquerda. As linhas avançam um pixel por vez verticalmente."

#: ../../library/framebuf.rst:193
msgid "``MONO_HMSB``"
msgstr "``MONO_HMSB``"

#: ../../library/framebuf.rst:195
msgid "Monochrome (1-bit). Like ``MONO_HLSB`` but with bit 0 leftmost."
msgstr ""
"Monocromático (1 bit). Como ``MONO_HLSB``\\ , mas com o bit 0 mais à "
"esquerda."

#: ../../library/framebuf.rst:196
msgid "``GS2_HMSB``"
msgstr "``GS2_HMSB``"

#: ../../library/framebuf.rst:197
msgid "0.25"
msgstr "0.25"

#: ../../library/framebuf.rst:198
msgid ""
"2-bit greyscale (4 levels), packed horizontally most-significant bit first."
msgstr ""
"Escala de cinza de 2 bits (4 níveis), empacotada horizontalmente com o bit "
"mais significativo primeiro."

#: ../../library/framebuf.rst:200
msgid "``GS4_HMSB``"
msgstr "``GS4_HMSB``"

#: ../../library/framebuf.rst:201
msgid "0.5"
msgstr "0.5"

#: ../../library/framebuf.rst:202
msgid ""
"4-bit greyscale (16 levels), packed horizontally most-significant nibble "
"first."
msgstr ""
"Escala de cinza de 4 bits (16 níveis), empacotada horizontalmente com o "
"nibble mais significativo primeiro."

#: ../../library/framebuf.rst:204
msgid "``GS8``"
msgstr "``GS8``"

#: ../../library/framebuf.rst:205
msgid "1"
msgstr "1"

#: ../../library/framebuf.rst:206
msgid "8-bit greyscale (256 levels)."
msgstr "Escala de cinza de 8 bits (256 níveis)."

#: ../../library/framebuf.rst:207
msgid "``RGB565``"
msgstr "``RGB565``"

#: ../../library/framebuf.rst:208
msgid "2"
msgstr "2"

#: ../../library/framebuf.rst:209
msgid "16-bit RGB with 5 red, 6 green and 5 blue bits."
msgstr "RGB de 16 bits com 5 bits de vermelho, 6 de verde e 5 de azul."

#: ../../library/framebuf.rst:211
msgid ""
"``framebuf.MVLSB`` is a deprecated alias for ``framebuf.MONO_VLSB``; prefer "
"the latter in new code."
msgstr ""
"``framebuf.MVLSB`` é um alias obsoleto de ``framebuf.MONO_VLSB``\\ ; prefira"
" o segundo em código novo."

