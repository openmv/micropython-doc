msgstr "Referência da linguagem, sintaxe e semântica do runtime principal."

msgid "Libraries"
msgstr "Bibliotecas principais"

msgid "License"
msgstr "Licença"

msgid ""
"Live face detection, AprilTag tracking, QR scanning, and YOLO. All on-device"
" in pure MicroPython. No host computer, no cloud."
msgstr ""
"Detecção de rostos ao vivo, rastreamento de AprilTag, leitura de QR e YOLO. "
"Tudo no dispositivo, em MicroPython puro. Sem computador host, sem nuvem."

msgid ""
"Loaded from <code>/rom/blazeface_front_128.tflite</code> — pre-quantised, no"
" download needed."
msgstr ""
"Carregado de <code>/rom/blazeface_front_128.tflite</code> — pré-quantizado, "
"sem necessidade de download."

msgid ""
"Loaded from <code>/rom/hand_landmarks_full_224.tflite</code> — running "
"standalone here, without palm detection upstream."
msgstr ""
"Carregado de <code>/rom/hand_landmarks_full_224.tflite</code> — executando "
"de forma independente, sem detecção de palma anterior."

msgid ""
"Loaded from <code>/rom/yolov8n_192.tflite</code> — no SD card or download "
"needed."
msgstr ""
"Carregado de <code>/rom/yolov8n_192.tflite</code> — sem necessidade de "
"cartão SD ou download."

msgid "Locate and identify AprilTags"
msgstr "Localizar e identificar AprilTags"

msgid "Low-level hardware: GPIO, SPI, I²C, UART, PWM, ADC, and timers."
msgstr ""
"Hardware de baixo nível: GPIO, SPI, I²C, UART, PWM, ADC e temporizadores."

msgid "Machine vision,<br>made simple."
msgstr "Visão computacional,<br>simplificada."

msgid "Machine vision: blobs, edges, lines, circles, features, and drawing."
msgstr ""
"Visão computacional: regiões, bordas, linhas, círculos, características e "
"desenho."

