msgstr "Produtos, aplicações, downloads e notícias."

msgid "Prophesee event-based vision — microsecond temporal precision."
msgstr ""
"Visão baseada em eventos Prophesee — precisão temporal de microssegundos."

msgid "QR code detection"
msgstr "Detecção de código QR"

msgid "Quick start guide"
msgstr "Guia de início rápido"

