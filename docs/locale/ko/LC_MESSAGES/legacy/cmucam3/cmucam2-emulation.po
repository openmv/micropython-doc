msgstr "GT 트래킹 매개변수 가져오기"

#: ../../legacy/cmucam3/cmucam2-emulation.rst:58
msgid "GV Get Version"
msgstr "GV 버전 가져오기"

#: ../../legacy/cmucam3/cmucam2-emulation.rst:59
msgid "GW Get Window"
msgstr "GW 윈도우 가져오기"

#: ../../legacy/cmucam3/cmucam2-emulation.rst:60
msgid "HC Historgram Configure"
msgstr "HC 히스토그램 구성"

#: ../../legacy/cmucam3/cmucam2-emulation.rst:61
msgid "HD High Resolution Difference"
msgstr "HD 고해상도 차분"

#: ../../legacy/cmucam3/cmucam2-emulation.rst:62
