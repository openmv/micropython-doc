msgid "Constant"
msgstr "상수"

#: ../../library/pyb.ExtInt.rst:68
msgid "Trigger"
msgstr "트리거"

#: ../../library/pyb.ExtInt.rst:69
msgid ":data:`ExtInt.IRQ_RISING`"
msgstr ":data:`ExtInt.IRQ_RISING`"

#: ../../library/pyb.ExtInt.rst:70
msgid "Rising edge."
msgstr "상승 에지."

#: ../../library/pyb.ExtInt.rst:71
msgid ":data:`ExtInt.IRQ_FALLING`"
msgstr ":data:`ExtInt.IRQ_FALLING`"

#: ../../library/pyb.ExtInt.rst:72
msgid "Falling edge."
msgstr "하강 에지."

#: ../../library/pyb.ExtInt.rst:73
msgid ":data:`ExtInt.IRQ_RISING_FALLING`"
msgstr ":data:`ExtInt.IRQ_RISING_FALLING`"

