msgstr "set"

#: ../../openmvcam/tutorial/python/collections/sets.rst:65
msgid "dict"
msgstr "dict"

#: ../../openmvcam/tutorial/python/collections/sets.rst:67
msgid "holds"
msgstr "담는 것"

#: ../../openmvcam/tutorial/python/collections/sets.rst:67
msgid "unique items"
msgstr "고유한 항목"

#: ../../openmvcam/tutorial/python/collections/sets.rst:67
msgid "unique keys, each with a value"
msgstr "고유한 키, 각각 값을 가짐"

#: ../../openmvcam/tutorial/python/collections/sets.rst:70
msgid "populated literal"
msgstr "내용이 있는 리터럴"

#: ../../openmvcam/tutorial/python/collections/sets.rst:70
#, python-brace-format
msgid "``{1, 2, 3}``"
msgstr "``{1, 2, 3}``"

#: ../../openmvcam/tutorial/python/collections/sets.rst:70
#, python-brace-format
msgid "``{\"a\": 1, \"b\": 2}``"
msgstr "``{\"a\": 1, \"b\": 2}``"

#: ../../openmvcam/tutorial/python/collections/sets.rst:72
msgid "empty literal"
msgstr "빈 리터럴"

#: ../../openmvcam/tutorial/python/collections/sets.rst:72
msgid "``set()``"
msgstr "``set()``"

#: ../../openmvcam/tutorial/python/collections/sets.rst:72
#, python-brace-format
msgid "``{}``"
msgstr "``{}``"

#: ../../openmvcam/tutorial/python/collections/sets.rst:74
msgid "membership test"
msgstr "멤버십 검사"

#: ../../openmvcam/tutorial/python/collections/sets.rst:74
msgid "``x in s``"
msgstr "``x in s``"

#: ../../openmvcam/tutorial/python/collections/sets.rst:74
msgid "``k in d`` (keys only)"
msgstr "``k in d`` (키만)"

#: ../../openmvcam/tutorial/python/collections/sets.rst:76
msgid "fetch a value"
msgstr "값 가져오기"

#: ../../openmvcam/tutorial/python/collections/sets.rst:76
msgid "n/a"
msgstr "해당 없음"

