msgstr "**MLX90621** — 16 × 4 IR 어레이"

#: ../../openmvcam/quickref/arduino-nano-33-ble-sense.rst:572
msgid "**MLX90640** — 32 × 24 IR array"
msgstr "**MLX90640** — 32 × 24 IR 어레이"

#: ../../openmvcam/quickref/arduino-nano-33-ble-sense.rst:573
msgid "**MLX90641** — 16 × 12 IR array"
msgstr "**MLX90641** — 16 × 12 IR 어레이"

