#: ../../openmvcam/quickref/arduino-giga-r1-wifi.rst:825
msgid "**MLX90621** — 16 × 4 IR array"
msgstr "**MLX90621** — 16 × 4 IR 어레이"

#: ../../openmvcam/quickref/arduino-giga-r1-wifi.rst:826
