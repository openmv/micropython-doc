msgstr ""
"Dacă este ``True``\\ , notifică/indică de asemenea fiecare conexiune "
"abonată."

#: ../../library/aioble.rst:545
msgid "Send a GATT Notify to *connection*."
msgstr "Trimite un GATT Notify către *connection*\\ ."

#: ../../library/aioble.rst:547 ../../library/aioble.rst:559
msgid "*connection*"
msgstr "*connection*"

