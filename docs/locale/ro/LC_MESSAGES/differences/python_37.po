msgid ""
"New features include *gc.freeze()*, *gc.unfreeze()*, *gc-get_freeze_count*"
msgstr ""
"Funcționalitățile noi includ *gc.freeze()*\\ , *gc.unfreeze()*\\ , *gc-"
"get_freeze_count*"

