msgid "Mode"
msgstr "Mod"

#: ../../openmvcam/sensors/genx320.rst:373
msgid "Keeps"
msgstr "Păstrează"

#: ../../openmvcam/sensors/genx320.rst:373
msgid "Drops"
msgstr "Elimină"

