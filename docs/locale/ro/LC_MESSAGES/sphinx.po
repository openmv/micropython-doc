msgid "1-MP global-shutter colour + FLIR Lepton thermal on one module."
msgstr ""
"Color cu obturator global de 1 MP + termic FLIR Lepton pe un singur modul."

msgid "1.8–5.5V battery input via a DC barrel jack."
msgstr "Intrare baterie 1,8–5,5V printr-un conector DC cilindric."

msgid "10 Mb/s differential serial for industrial buses."
msgstr "Serial diferențial de 10 Mb/s pentru magistrale industriale."

msgid "10/100 Ethernet with Power-over-Ethernet."
msgstr "Ethernet 10/100 cu Power-over-Ethernet."

msgid "2.3\" SPI LCD with capacitive multi-touch and Qwiic."
msgstr "LCD SPI de 2,3\" cu multi-touch capacitiv și Qwiic."

msgid "5MP HDR sensor — high dynamic range for tough lighting."
msgstr "Senzor HDR de 5MP — gamă dinamică ridicată pentru iluminare dificilă."

msgid "5MP rolling-shutter colour + FLIR Lepton thermal on one module."
msgstr ""
"Color cu obturator rulant de 5MP + termic FLIR Lepton pe un singur modul."

msgid "6µA standby motion trigger plus white and 850 nm IR."
msgstr "Declanșator de mișcare în standby de 6µA plus IR alb și 850 nm."

msgid "8 Mb/s CAN-FD plus 1 Mb/s RS-232 in one shield."
msgstr "CAN-FD de 8 Mb/s plus RS-232 de 1 Mb/s într-un singur shield."

msgid ""
"<code>find_blobs</code> returns connected pixel regions matching one or more"
" LAB thresholds."
msgstr ""
"<code>find_blobs</code> returnează regiuni de pixeli conectați care "
"corespund unuia sau mai multor praguri LAB."

msgid ""
"<code>ml.utils.draw_skeleton</code> draws all 21 joints and connections in "
"one call."
msgstr ""
"<code>ml.utils.draw_skeleton</code> desenează toate cele 21 de articulații "
"și conexiuni într-un singur apel."

msgid ""
"<code>pixels_threshold</code> filters tiny detections; "
"<code>merge=True</code> joins overlapping blobs."
msgstr ""
"<code>pixels_threshold</code> filtrează detecțiile mici; "
"<code>merge=True</code> unește regiunile suprapuse."

msgid "API"
msgstr "API"

msgid "API reference"
msgstr "Referință API"

msgid "Adapter for FLIR Boson / Boson+ — higher-resolution thermal."
msgstr "Adaptor pentru FLIR Boson / Boson+ — termic de rezoluție mai mare."

msgid "Adapter for FLIR Lepton 1.x / 2.x / 3.x thermal cores."
msgstr "Adaptor pentru nuclee termice FLIR Lepton 1.x / 2.x / 3.x."

msgid ""
"Add-on boards that plug into the OpenMV Cam — networking, motor control, "
"displays, and more."
msgstr ""
"Plăci suplimentare care se conectează la OpenMV Cam — rețele, control "
"motoare, ecrane și altele."

msgid "Add-ons"
msgstr "Suplimente"

msgid "Alif Ensemble E3 — fusion-class Cortex-M55 with Ethos-U55 NPU."
msgstr "Alif Ensemble E3 — Cortex-M55 de clasă fusion cu NPU Ethos-U55."

msgid "AprilTag tracking"
msgstr "Urmărire AprilTag"

msgid ""
"AprilTags are 2D fiducial markers — robust to motion blur and partial "
"occlusion, and they give you full 3D pose."
msgstr ""
"AprilTag-urile sunt markeri fiduciali 2D — robuști la estomparea de mișcare "
"și ocluzia parțială și furnizează poziția 3D completă."

msgid "Async Bluetooth Low Energy — peripherals, advertising, and GATT."
msgstr "Bluetooth Low Energy asincron — periferice, publicitate și GATT."

msgid "Back to top"
msgstr "Înapoi sus"

