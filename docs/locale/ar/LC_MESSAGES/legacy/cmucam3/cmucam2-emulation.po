#: ../../legacy/cmucam3/cmucam2-emulation.rst:68
msgid "NF Noise Filter"
msgstr "NF مرشح الضوضاء"

#: ../../legacy/cmucam3/cmucam2-emulation.rst:69
msgid "OM Output Packet Mask"
msgstr "OM قناع حزمة الخرج"

#: ../../legacy/cmucam3/cmucam2-emulation.rst:70
msgid "PD Pixel Difference (not supported)"
msgstr "PD فرق البكسل (غير مدعوم)"

#: ../../legacy/cmucam3/cmucam2-emulation.rst:71
msgid "PF Packet Filter"
msgstr "PF مرشح الحزم"

#: ../../legacy/cmucam3/cmucam2-emulation.rst:72
msgid "PM Poll Mode"
