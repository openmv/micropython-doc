msgstr "تهيئة مرحلة خرج التردد الراديوي للمودم (\\ ``AT+RFPOWER``\\ )."

#: ../../library/omv.lora.rst:248
msgid "One of :data:`RF_MODE_RFO`, :data:`RF_MODE_PABOOST`."
msgstr "أحد :data:`RF_MODE_RFO` أو :data:`RF_MODE_PABOOST`\\ ."

#: ../../library/omv.lora.rst:249
