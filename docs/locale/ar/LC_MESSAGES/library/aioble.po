#: ../../library/aioble.rst:472
msgid ""
"Generator yielding ``(company_id, data)`` tuples from manufacturer-specific "
"advertising fields."
msgstr ""
"مولّد (generator) يُنتج صفوف (tuples) ``(company_id, data)`` من حقول الإعلان"
