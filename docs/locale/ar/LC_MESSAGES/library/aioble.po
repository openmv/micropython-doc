msgid "*max_len*"
msgstr "*max_len*"

#: ../../library/aioble.rst:590
msgid "Buffer size, in bytes."
msgstr "حجم المخزن بالبايتات."

#: ../../library/aioble.rst:592
msgid "*append*"
msgstr "*append*"

