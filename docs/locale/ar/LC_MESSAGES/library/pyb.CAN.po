msgstr "استقبال البيانات على الناقل:"

#: ../../library/pyb.CAN.rst:295
msgid "*fifo* is an integer, which is the FIFO to receive on"
msgstr "*fifo* عدد صحيح، وهو الـ FIFO المراد الاستقبال عليه"

