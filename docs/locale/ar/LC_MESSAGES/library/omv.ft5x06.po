msgid "Touch screen move up gesture."
msgstr "إيماءة التحريك للأعلى على شاشة اللمس."

#: ../../library/omv.ft5x06.rst:89
msgid "Touch screen move left gesture."
msgstr "إيماءة التحريك لليسار على شاشة اللمس."

#: ../../library/omv.ft5x06.rst:94
msgid "Touch screen move down gesture."
msgstr "إيماءة التحريك للأسفل على شاشة اللمس."

#: ../../library/omv.ft5x06.rst:99
msgid "Touch screen move right gesture."
msgstr "إيماءة التحريك لليمين على شاشة اللمس."

#: ../../library/omv.ft5x06.rst:104
msgid "Touch screen zoom in gesture."
msgstr "إيماءة التكبير على شاشة اللمس."

#: ../../library/omv.ft5x06.rst:109
msgid "Touch screen zoom out gesture."
msgstr "إيماءة التصغير على شاشة اللمس."

#: ../../library/omv.ft5x06.rst:114
msgid "No gesture."
msgstr "لا توجد إيماءة."

#: ../../library/omv.ft5x06.rst:119
msgid "Touch point is pressed."
msgstr "نقطة اللمس مضغوطة."

#: ../../library/omv.ft5x06.rst:124
msgid "Touch point is released."
msgstr "نقطة اللمس محرّرة."

#: ../../library/omv.ft5x06.rst:129
msgid "Touch point is moved."
msgstr "نقطة اللمس متحرّكة."
