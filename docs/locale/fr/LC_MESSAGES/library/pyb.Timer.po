msgid "Output-compare timing mode; no pin is driven."
msgstr ""
"Mode de temporisation par comparaison de sortie ; aucune broche n'est "
"pilotée."

#: ../../library/pyb.Timer.rst:302
msgid "Output-compare active mode; the pin is made active on compare match."
msgstr ""
"Mode actif par comparaison de sortie ; la broche est rendue active lors "
"d'une correspondance de comparaison."

#: ../../library/pyb.Timer.rst:307
msgid ""
"Output-compare inactive mode; the pin is made inactive on compare match."
msgstr ""
"Mode inactif par comparaison de sortie ; la broche est rendue inactive lors "
"d'une correspondance de comparaison."

#: ../../library/pyb.Timer.rst:312
msgid "Output-compare toggle mode; the pin toggles on compare match."
msgstr ""
"Mode bascule par comparaison de sortie ; l'état de la broche bascule lors "
"d'une correspondance de comparaison."

#: ../../library/pyb.Timer.rst:317
msgid ""
"Output-compare forced-active mode; the pin is forced active and the compare "
"match is ignored."
msgstr ""
"Mode actif forcé par comparaison de sortie ; la broche est forcée à l'état "
"actif et la correspondance de comparaison est ignorée."

#: ../../library/pyb.Timer.rst:323
msgid ""
"Output-compare forced-inactive mode; the pin is forced inactive and the "
"compare match is ignored."
msgstr ""
"Mode inactif forcé par comparaison de sortie ; la broche est forcée à l'état"
" inactif et la correspondance de comparaison est ignorée."

#: ../../library/pyb.Timer.rst:329
msgid "Configure the channel for input-capture mode."
msgstr "Configure le canal en mode capture d'entrée."

#: ../../library/pyb.Timer.rst:334
msgid "Encoder mode: the counter only changes when CH1 changes."
msgstr "Mode encodeur : le compteur ne change que lorsque CH1 change."

#: ../../library/pyb.Timer.rst:339
msgid "Encoder mode: the counter only changes when CH2 changes."
msgstr "Mode encodeur : le compteur ne change que lorsque CH2 change."

#: ../../library/pyb.Timer.rst:344
msgid "Encoder mode: the counter changes whenever CH1 or CH2 changes."
msgstr "Mode encodeur : le compteur change chaque fois que CH1 ou CH2 change."

