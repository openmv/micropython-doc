msgstr "*modestr*"

#: ../../library/pyb.rst:282
msgid "Configures"
msgstr "Configure"

#: ../../library/pyb.rst:283
msgid "``None``"
msgstr "``None``"

#: ../../library/pyb.rst:284
msgid "Disables USB."
msgstr "Désactive l'USB."

#: ../../library/pyb.rst:285
msgid "``'VCP'``"
msgstr "``'VCP'``"

#: ../../library/pyb.rst:286
msgid "VCP (Virtual COM Port) only."
msgstr "VCP (Virtual COM Port) uniquement."

#: ../../library/pyb.rst:287
msgid "``'MSC'``"
msgstr "``'MSC'``"

#: ../../library/pyb.rst:288
msgid "MSC (USB mass storage class) only."
msgstr "MSC (classe de stockage de masse USB) uniquement."

#: ../../library/pyb.rst:289
msgid "``'VCP+MSC'``"
msgstr "``'VCP+MSC'``"

#: ../../library/pyb.rst:290
msgid "VCP and MSC."
msgstr "VCP et MSC."

#: ../../library/pyb.rst:291
msgid "``'VCP+HID'``"
msgstr "``'VCP+HID'``"

#: ../../library/pyb.rst:292
msgid "VCP and HID (human interface device)."
msgstr "VCP et HID (périphérique d'interface humaine)."

#: ../../library/pyb.rst:293
msgid "``'VCP+MSC+HID'``"
msgstr "``'VCP+MSC+HID'``"

#: ../../library/pyb.rst:294
msgid "VCP, MSC and HID together. Not supported on every OpenMV Cam."
msgstr ""
