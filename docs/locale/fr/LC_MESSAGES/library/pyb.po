msgstr "Obtient ou définit l'objet UART sur lequel le REPL est répété."

#: ../../library/pyb.rst:260
msgid "Return a 30-bit hardware generated random number."
msgstr "Renvoie un nombre aléatoire généré par le matériel sur 30 bits."

#: ../../library/pyb.rst:264
msgid "Sync all file systems."
msgstr "Synchronise tous les systèmes de fichiers."

#: ../../library/pyb.rst:268
msgid ""
"Returns a string of 12 bytes (96 bits), which is the unique ID of the MCU."
msgstr ""
"Renvoie une chaîne de 12 octets (96 bits), qui est l'identifiant unique du "
"MCU."

#: ../../library/pyb.rst:272
msgid "If called with no arguments, return the current USB mode as a string."
msgstr ""
"Si elle est appelée sans argument, renvoie le mode USB actuel sous forme de "
"chaîne."

#: ../../library/pyb.rst:274
