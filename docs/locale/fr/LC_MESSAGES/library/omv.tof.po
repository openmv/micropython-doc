msgid "``vflip=False, hmirror=False, transpose=False`` -> 0 degree rotation"
msgstr ""
"``vflip=False, hmirror=False, transpose=False`` -> rotation de 0 degré"

#: ../../library/omv.tof.rst:40
msgid "``vflip=True,  hmirror=False, transpose=True``  -> 90 degree rotation"
msgstr ""
"``vflip=True,  hmirror=False, transpose=True``  -> rotation de 90 degrés"

