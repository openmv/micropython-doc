#: ../../changelog/firmware/v4.1.4.rst:4
msgid "v4.1.4"
msgstr "v4.1.4"

#: ../../changelog/firmware/v4.1.4.rst:6
msgid ""
"v4.1.4 is a maintenance release that updates the bundled MicroPython "
"submodule. It introduces **no breaking API changes** — v4.1.3 scripts run "
"unchanged."
msgstr ""
"v4.1.4 est une version de maintenance qui met à jour le sous-module "
"MicroPython fourni. Elle n'introduit **aucun changement d'API incompatible**"
" — les scripts v4.1.3 s'exécutent sans modification."

#: ../../changelog/firmware/v4.1.4.rst:13
msgid "On this page"
msgstr "Sur cette page"

#: ../../changelog/firmware/v4.1.4.rst:16
msgid "Highlights"
msgstr "Points forts"

#: ../../changelog/firmware/v4.1.4.rst:18
msgid "**MicroPython submodule updated.**"
msgstr "**Sous-module MicroPython mis à jour.**"

#: ../../changelog/firmware/v4.1.4.rst:19
msgid ""
"**No breaking API changes** — reflash and your v4.1.3 scripts run unchanged."
msgstr ""
"**Aucun changement d'API incompatible** — reflashez et vos scripts v4.1.3 "
"s'exécutent sans modification."

#: ../../changelog/firmware/v4.1.4.rst:23
msgid "Other changes and improvements"
msgstr "Autres changements et améliorations"

#: ../../changelog/firmware/v4.1.4.rst:25
msgid ""
"The bundled MicroPython submodule was updated (upstream fixes and "
"improvements)."
msgstr ""
"Le sous-module MicroPython fourni a été mis à jour (corrections et "
"améliorations amont)."

#: ../../changelog/firmware/v4.1.4.rst:29
msgid "Breaking API changes"
msgstr "Changements d'API incompatibles"

#: ../../changelog/firmware/v4.1.4.rst:31
msgid ""
"v4.1.4 introduces **no breaking Python API changes**. Scripts that ran on "
"v4.1.3 run unchanged on v4.1.4 — just reflash the firmware."
msgstr ""
"v4.1.4 n'introduit **aucun changement d'API Python incompatible**. Les "
"scripts qui s'exécutaient sur v4.1.3 s'exécutent sans modification sur "
"v4.1.4 — il suffit de reflasher le micrologiciel."
