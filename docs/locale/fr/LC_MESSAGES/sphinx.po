msgstr "Licence"

msgid ""
"Live face detection, AprilTag tracking, QR scanning, and YOLO. All on-device"
" in pure MicroPython. No host computer, no cloud."
msgstr ""
"Détection de visages en direct, suivi AprilTag, lecture QR et YOLO. Tout sur"
" l'appareil, en MicroPython pur. Pas d'ordinateur hôte, pas de cloud."

msgid ""
"Loaded from <code>/rom/blazeface_front_128.tflite</code> — pre-quantised, no"
" download needed."
msgstr ""
"Chargé depuis <code>/rom/blazeface_front_128.tflite</code> — pré-quantifié, "
"aucun téléchargement requis."

msgid ""
"Loaded from <code>/rom/hand_landmarks_full_224.tflite</code> — running "
"standalone here, without palm detection upstream."
msgstr ""
"Chargé depuis <code>/rom/hand_landmarks_full_224.tflite</code> — fonctionne "
"de manière autonome ici, sans détection de paume en amont."

msgid ""
"Loaded from <code>/rom/yolov8n_192.tflite</code> — no SD card or download "
"needed."
msgstr ""
"Chargé depuis <code>/rom/yolov8n_192.tflite</code> — aucune carte SD ni "
"téléchargement requis."

msgid "Locate and identify AprilTags"
msgstr "Localiser et identifier des AprilTags"

msgid "Low-level hardware: GPIO, SPI, I²C, UART, PWM, ADC, and timers."
msgstr "Matériel bas niveau : GPIO, SPI, I²C, UART, PWM, ADC et minuteries."

msgid "Machine vision,<br>made simple."
msgstr "Vision artificielle,<br>simplifiée."

msgid "Machine vision: blobs, edges, lines, circles, features, and drawing."
msgstr ""
"Vision artificielle : zones, contours, lignes, cercles, caractéristiques et "
"dessin."

