msgid "Highlights"
msgstr "Points forts"

#: ../../openmvcam/sensors/mt9v024.rst:17
msgid "752x480 global-shutter monochrome sensor"
msgstr "Capteur monochrome à obturateur global 752x480"

#: ../../openmvcam/sensors/mt9v024.rst:18
