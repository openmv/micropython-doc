#: ../../library/pyb.CAN.rst:87
msgid "Initialise the CAN bus with the given parameters:"
msgstr "使用给定参数初始化 CAN 总线："

#: ../../library/pyb.CAN.rst:89
msgid "*mode* is one of:  NORMAL, LOOPBACK, SILENT, SILENT_LOOPBACK"
