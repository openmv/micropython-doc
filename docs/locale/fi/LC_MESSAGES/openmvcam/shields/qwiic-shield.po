#: ../../openmvcam/shields/qwiic-shield.rst:1
msgid "Qwiic SCL — I²C clock to both Qwiic connectors"
msgstr "Qwiic SCL — I²C-kello molempiin Qwiic-liittimiin"

#: ../../openmvcam/shields/qwiic-shield.rst:1
msgid "P5"
msgstr "P5"

#: ../../openmvcam/shields/qwiic-shield.rst:1
msgid "Qwiic SDA — I²C data to both Qwiic connectors"
msgstr "Qwiic SDA — I²C-data molempiin Qwiic-liittimiin"

#: ../../openmvcam/shields/qwiic-shield.rst:1
msgid "3.3V rail"
msgstr "3,3 V kisko"

#: ../../openmvcam/shields/qwiic-shield.rst:1
