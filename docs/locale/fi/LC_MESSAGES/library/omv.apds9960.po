#: ../../library/omv.apds9960.rst:338
msgid "Set the 16-bit low threshold used for the ambient-light interrupt."
msgstr ""
"Aseta ympäristönvalon keskeytykseen käytetty 16-bittinen matala kynnysarvo."

#: ../../library/omv.apds9960.rst:342
msgid "Return the 16-bit high threshold used for the ambient-light interrupt."
msgstr ""
"Palauta ympäristönvalon keskeytykseen käytetty 16-bittinen korkea "
"kynnysarvo."

#: ../../library/omv.apds9960.rst:346
msgid "Set the 16-bit high threshold used for the ambient-light interrupt."
msgstr ""
"Aseta ympäristönvalon keskeytykseen käytetty 16-bittinen korkea kynnysarvo."

#: ../../library/omv.apds9960.rst:349
msgid "Interrupt enables and clears"
msgstr "Keskeytysten käyttöönotot ja tyhjennykset"

