msgid "Return ``True`` if ambient-light interrupts are enabled."
msgstr "Palauttaa ``True``\\ , jos ympäristönvalon keskeytykset ovat käytössä."

#: ../../library/omv.apds9960.rst:357
msgid "Enable or disable ambient-light interrupts."
msgstr "Ota käyttöön tai poista käytöstä ympäristönvalon keskeytykset."

#: ../../library/omv.apds9960.rst:361
msgid "Return ``True`` if proximity interrupts are enabled."
msgstr "Palauttaa ``True``\\ , jos läheisyyskeskeytykset ovat käytössä."

