msgstr "*fifo* on vastaanottava FIFO."

#: ../../library/pyb.CAN.rst:357
msgid "*fun* is the function to be called when the FIFO becomes non-empty."
msgstr "*fun* on funktio, jota kutsutaan, kun FIFO muuttuu ei-tyhjäksi."

