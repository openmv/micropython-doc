msgstr ""
"Jos ``True``\\ , kirjoitetut arvot jonotetaan (enintään 10 syvyyteen), jotta"
" nopeita peräkkäisiä kirjoituksia ei menetetä. Kukin `written` -kutsu "
"palauttaa tällöin ``(connection, data)`` -monikon."

#: ../../library/aioble.rst:522
msgid "Bitmask of the GATT property flags built from the constructor."
msgstr ""
"Bittimaski GATT-ominaisuuslipuista, jotka rakennetaan konstruktorista."

#: ../../library/aioble.rst:526
msgid "List of `Descriptor` objects bound to this characteristic."
msgstr "Luettelo tähän ominaisuuteen sidotuista `Descriptor` -objekteista."

#: ../../library/aioble.rst:530
msgid "Read the current value from the local GATT database."
msgstr "Lue nykyinen arvo paikallisesta GATT-tietokannasta."

#: ../../library/aioble.rst:534
msgid "Update the value in the local GATT database."
msgstr "Päivitä arvo paikallisessa GATT-tietokannassa."

#: ../../library/aioble.rst:536 ../../library/aioble.rst:550
#: ../../library/aioble.rst:562 ../../library/aioble.rst:681
msgid "*data*"
msgstr "*data*"

#: ../../library/aioble.rst:537
msgid "New value bytes."
msgstr "Uudet arvotavut."

#: ../../library/aioble.rst:539
msgid "*send_update*"
msgstr "*send_update*"

