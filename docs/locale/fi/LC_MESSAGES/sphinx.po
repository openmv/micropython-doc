msgstr "MicroPython GitHubissa"

msgid "Minimal HTTP server — routes, sessions, login, SSE, and WebSockets."
msgstr ""
"Minimaalinen HTTP-palvelin — reitit, istunnot, kirjautuminen, SSE ja "
"WebSocketit."

msgid "Monochrome global-shutter sensor for fast-motion capture."
msgstr "Mustavalkoinen global-shutter-anturi nopealiikkeiseen tallentamiseen."

