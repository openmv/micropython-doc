#: ../../library/pyb.Timer.rst:227
msgid "Get or set the timer counter."
msgstr "取得或設定計時器計數器。"

#: ../../library/pyb.Timer.rst:231
msgid ""
"Get or set the frequency for the timer (changes prescaler and period if "
"set)."
msgstr "取得或設定計時器的頻率（若設定，會同時改變預分頻器與週期）。"

#: ../../library/pyb.Timer.rst:235
msgid "Get or set the period of the timer."
msgstr "取得或設定計時器的週期。"

