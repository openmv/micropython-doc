msgstr "TIM2 CH4"

#: ../../openmvcam/quickref/openmv-pure-thermal.rst:693
msgid "TIM2 CH1"
msgstr "TIM2 CH1"

#: ../../openmvcam/quickref/openmv-pure-thermal.rst:694
