msgid ""
"New features include *gc.freeze()*, *gc.unfreeze()*, *gc-get_freeze_count*"
msgstr "新功能包括 *gc.freeze()*\\ 、\\ *gc.unfreeze()*\\ 、\\ *gc-get_freeze_count*"

