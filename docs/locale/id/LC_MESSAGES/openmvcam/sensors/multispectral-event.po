msgstr "Sensor event 320x320, rentang dinamis >140 dB, histogram 375 Hz+"

#: ../../openmvcam/sensors/multispectral-event.rst:22
msgid "PAG7936 colour: 1280x800 @ 120 FPS, 640x400 @ 240 FPS"
msgstr "PAG7936 warna: 1280x800 @ 120 FPS, 640x400 @ 240 FPS"

#: ../../openmvcam/sensors/multispectral-event.rst:23
msgid "Synchronised event timestamps with shared exposure trigger"
msgstr "Timestamp event tersinkronisasi dengan trigger eksposur bersama"

#: ../../openmvcam/sensors/multispectral-event.rst:24
