"Mode konfigurasi (\\ ``0x00``\\ ). Perangkat harus berada dalam mode ini "
"untuk mengubah register konfigurasi."

#: ../../library/omv.bno055.rst:143
msgid "Accelerometer-only non-fusion mode (``0x01``)."
msgstr "Mode non-fusi hanya akselerometer (\\ ``0x01``\\ )."

#: ../../library/omv.bno055.rst:148
msgid "Magnetometer-only non-fusion mode (``0x02``)."
msgstr "Mode non-fusi hanya magnetometer (\\ ``0x02``\\ )."

#: ../../library/omv.bno055.rst:153
