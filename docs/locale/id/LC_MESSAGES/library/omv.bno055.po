msgstr "Mode fusi magnet-untuk-giroskop (\\ ``0x0A``\\ )."

#: ../../library/omv.bno055.rst:193
msgid ""
"9-DOF fusion mode with fast magnetometer calibration disabled (``0x0B``)."
msgstr ""
"Mode fusi 9-DOF dengan kalibrasi magnetometer cepat dinonaktifkan (\\ "
