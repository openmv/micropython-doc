#: ../../genrst/syntax.rst:46
msgid "Operators"
msgstr "Operator"

#: ../../genrst/syntax.rst:51
msgid ""
"MicroPython allows using := to assign to the variable of a comprehension, "
"CPython raises a SyntaxError."
msgstr ""
"MicroPython memungkinkan penggunaan := untuk menetapkan nilai ke variabel "
"comprehension, CPython menimbulkan SyntaxError."

#: ../../genrst/syntax.rst:53
msgid ""
"**Cause:** MicroPython is optimised for code size and doesn't check this "
"case."
msgstr ""
"**Penyebab:** MicroPython dioptimalkan untuk ukuran kode dan tidak memeriksa"
" kasus ini."

#: ../../genrst/syntax.rst:55
msgid ""
"**Workaround:** Do not rely on this behaviour if writing CPython compatible "
"code."
msgstr ""
"**Solusi:** Jangan mengandalkan perilaku ini jika menulis kode yang "
"kompatibel dengan CPython."

#: ../../genrst/syntax.rst:73
msgid "Spaces"
msgstr "Spasi"

#: ../../genrst/syntax.rst:78
msgid "uPy requires spaces between literal numbers and keywords, CPy doesn't"
msgstr "uPy mengharuskan spasi antara angka literal dan kata kunci, CPy tidak"

#: ../../genrst/syntax.rst:107
msgid "Unicode"
msgstr "Unicode"

#: ../../genrst/syntax.rst:112
msgid "Unicode name escapes are not implemented"
msgstr "Escape nama Unicode tidak diimplementasikan"
