#: ../../genrst/syntax.rst:46
msgid "Operators"
msgstr "Toán tử (Operators)"

#: ../../genrst/syntax.rst:51
msgid ""
"MicroPython allows using := to assign to the variable of a comprehension, "
"CPython raises a SyntaxError."
msgstr ""
"MicroPython cho phép sử dụng := để gán cho biến của một comprehension, "
"CPython báo lỗi SyntaxError."

#: ../../genrst/syntax.rst:53
msgid ""
"**Cause:** MicroPython is optimised for code size and doesn't check this "
"case."
msgstr ""
"**Nguyên nhân:** MicroPython được tối ưu hóa cho kích thước mã và không kiểm"
" tra trường hợp này."

#: ../../genrst/syntax.rst:55
msgid ""
"**Workaround:** Do not rely on this behaviour if writing CPython compatible "
"code."
msgstr ""
"**Cách khắc phục:** Đừng dựa vào hành vi này nếu viết mã tương thích "
"CPython."

#: ../../genrst/syntax.rst:73
msgid "Spaces"
msgstr "Khoảng trắng (Spaces)"

#: ../../genrst/syntax.rst:78
msgid "uPy requires spaces between literal numbers and keywords, CPy doesn't"
msgstr "uPy yêu cầu khoảng trắng giữa số chữ và từ khóa, CPy không yêu cầu"

#: ../../genrst/syntax.rst:107
msgid "Unicode"
msgstr "Unicode"

#: ../../genrst/syntax.rst:112
msgid "Unicode name escapes are not implemented"
msgstr "Ký tự thoát tên Unicode chưa được triển khai"
