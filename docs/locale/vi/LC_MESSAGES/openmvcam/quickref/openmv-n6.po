msgstr "**CHG** — thấp trong khi pin LiPo gắn đang sạc."

#: ../../openmvcam/quickref/openmv-n6.rst:276
msgid "**PG** — low when VIN or USB power is present."
msgstr "**PG** — thấp khi có nguồn VIN hoặc USB."

