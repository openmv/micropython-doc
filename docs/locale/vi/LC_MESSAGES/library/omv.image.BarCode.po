#: ../../library/omv.image.BarCode.rst:65
msgid "`image.ISBN10`"
msgstr "`image.ISBN10`"

#: ../../library/omv.image.BarCode.rst:66
msgid "`image.UPCA`"
msgstr "`image.UPCA`"

#: ../../library/omv.image.BarCode.rst:67
msgid "`image.EAN13`"
msgstr "`image.EAN13`"

#: ../../library/omv.image.BarCode.rst:68
msgid "`image.ISBN13`"
msgstr "`image.ISBN13`"

#: ../../library/omv.image.BarCode.rst:69
msgid "`image.I25`"
msgstr "`image.I25`"

#: ../../library/omv.image.BarCode.rst:70
msgid "`image.DATABAR`"
msgstr "`image.DATABAR`"

#: ../../library/omv.image.BarCode.rst:71
msgid "`image.DATABAR_EXP`"
msgstr "`image.DATABAR_EXP`"

#: ../../library/omv.image.BarCode.rst:72
