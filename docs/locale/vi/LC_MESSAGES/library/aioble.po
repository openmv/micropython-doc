msgstr "*max_len*"

#: ../../library/aioble.rst:590
msgid "Buffer size, in bytes."
msgstr "Kích thước bộ đệm, tính bằng byte."

#: ../../library/aioble.rst:592
msgid "*append*"
msgstr "*append*"

#: ../../library/aioble.rst:593
msgid ""
"If ``True``, sequential writes append into the buffer instead of "
"overwriting."
msgstr "Nếu ``True``\\ , các lần ghi tuần tự sẽ thêm vào bộ đệm thay vì ghi đè."

