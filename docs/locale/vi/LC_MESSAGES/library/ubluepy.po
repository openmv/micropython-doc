msgstr ""
"Tập hợp tính năng có sẵn phụ thuộc vào SoftDevice được flash bởi firmware:"

#: ../../library/ubluepy.rst:20
msgid ""
"**s140** (Nano 33 BLE Sense) --- both peripheral *and* central (scanner) "
"roles. This is what the OpenMV firmware ships."
msgstr ""
"**s140** (Nano 33 BLE Sense) --- cả hai vai trò peripheral *và* central "
"(scanner). Đây là phiên bản firmware OpenMV cung cấp."

#: ../../library/ubluepy.rst:22
msgid "**s132** --- both peripheral and central."
msgstr "**s132** --- cả peripheral và central."

#: ../../library/ubluepy.rst:23
msgid ""
"**s110** --- peripheral only; scanner / connect methods are compiled out."
msgstr ""
"**s110** --- chỉ peripheral; các phương thức scanner / connect được biên "
"dịch ra ngoài."

