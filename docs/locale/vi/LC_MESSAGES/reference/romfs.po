#: ../../reference/romfs.rst:264
msgid ""
"Build a ROMFS image from the directory *source* on the host PC.  The image "
"is written to *output* (default: ``<source>.romfs``)."
msgstr ""
"Xây dựng ảnh ROMFS từ thư mục *source* trên máy tính chủ. Ảnh được ghi vào "
"*output* (mặc định: ``<source>.romfs``\\ )."

#: ../../reference/romfs.rst:267 ../../reference/romfs.rst:300
msgid "Options:"
msgstr "Các tùy chọn:"

#: ../../reference/romfs.rst:269
msgid "``-o <output>``, ``--output <output>``: Specify the output file path."
msgstr ""
"``-o <output>``\\ , ``--output <output>``\\ : Chỉ định đường dẫn tệp đầu ra."

#: ../../reference/romfs.rst:270
msgid ""
