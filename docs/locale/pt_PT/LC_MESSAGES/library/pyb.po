#: ../../library/pyb.rst:140
msgid "``sysclk``"
msgstr "``sysclk``"

#: ../../library/pyb.rst:141
msgid "CPU frequency"
msgstr "Frequência da CPU"

#: ../../library/pyb.rst:142
msgid "``hclk``"
msgstr "``hclk``"

#: ../../library/pyb.rst:143
msgid "AHB bus, core memory and DMA frequency"
msgstr "Frequência do barramento AHB, memória central e DMA"

#: ../../library/pyb.rst:144
msgid "``pclk1``"
msgstr "``pclk1``"

#: ../../library/pyb.rst:145
msgid "APB1 bus frequency"
msgstr "Frequência do barramento APB1"

#: ../../library/pyb.rst:146
msgid "``pclk2``"
msgstr "``pclk2``"

