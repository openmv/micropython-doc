msgstr ""
"número de vezes que o controlador entrou no estado de Erro Passivo "
"(reiniciado para 0 após 65535)"

#: ../../library/pyb.CAN.rst:196
msgid ""
"number of times the controller entered the Bus Off state (wrapped around to "
"0 after 65535)"
msgstr ""
"número de vezes que o controlador entrou no estado Bus Off (reiniciado para "
