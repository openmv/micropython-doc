msgstr ""
"Chip virado para baixo, rodado 180° em relação a :data:`AXIS_P4`\\ . Eixos "
"de saída: ``X = -Yc``\\ , ``Y = -Xc``\\ , ``Z = -Zc``\\ ."

#: ../../library/omv.bno055.rst:326
msgid ""
"Chip face down, rotated 90° CW from :data:`AXIS_P4`. Output axes: ``X = "
"-Xc``, ``Y = +Yc``, ``Z = -Zc``."
msgstr ""
"Chip virado para baixo, rodado 90° CW em relação a :data:`AXIS_P4`\\ . Eixos"
" de saída: ``X = -Xc``\\ , ``Y = +Yc``\\ , ``Z = -Zc``\\ ."
