#: ../../changelog/ide/v4.0.14.rst:4
msgid "v4.0.14"
msgstr "v4.0.14"

#: ../../changelog/ide/v4.0.14.rst:6
msgid ""
"v4.0.14 is a maintenance release built on Qt Creator 10.0.1. It carries "
"internal updates only, with no user-facing feature, behavior, or workflow "
"changes, and no breaking changes."
msgstr ""
"A v4.0.14 é uma versão de manutenção baseada no Qt Creator 10.0.1. Contém "
"apenas atualizações internas, sem alterações de funcionalidades, "
"comportamento ou fluxo de trabalho visíveis para o utilizador, e sem "
"alterações incompatíveis."

#: ../../changelog/ide/v4.0.14.rst:13
msgid "On this page"
msgstr "Nesta página"

#: ../../changelog/ide/v4.0.14.rst:16
msgid "Highlights"
msgstr "Destaques"

#: ../../changelog/ide/v4.0.14.rst:18
msgid ""
"**Maintenance release** with internal updates only; no user-facing changes."
msgstr ""
"**Versão de manutenção** com apenas atualizações internas; sem alterações "
"visíveis para o utilizador."

#: ../../changelog/ide/v4.0.14.rst:22
msgid "Platform and tool support"
msgstr "Plataforma e suporte a ferramentas"

