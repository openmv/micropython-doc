msgstr "class YoloV5 -- YOLO V5"

#: ../../library/omv.ml.postprocessing.ultralytics.rst:15
msgid "Used to post-process YOLO V5 model output."
msgstr "A YOLO V5 modell kimenetének utófeldolgozásához használatos."

#: ../../library/omv.ml.postprocessing.ultralytics.rst:19
msgid "Create a YOLO V5 postprocessor."
