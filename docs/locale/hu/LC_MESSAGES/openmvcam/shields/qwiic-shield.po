#: ../../openmvcam/shields/qwiic-shield.rst:1
msgid "P4"
msgstr "P4"

#: ../../openmvcam/shields/qwiic-shield.rst:1
msgid "Qwiic SCL — I²C clock to both Qwiic connectors"
msgstr "Qwiic SCL — I²C órajel mindkét Qwiic csatlakozóhoz"

#: ../../openmvcam/shields/qwiic-shield.rst:1
msgid "P5"
msgstr "P5"

#: ../../openmvcam/shields/qwiic-shield.rst:1
msgid "Qwiic SDA — I²C data to both Qwiic connectors"
msgstr "Qwiic SDA — I²C adat mindkét Qwiic csatlakozóhoz"

#: ../../openmvcam/shields/qwiic-shield.rst:1
msgid "3.3V rail"
msgstr "3,3V sín"

#: ../../openmvcam/shields/qwiic-shield.rst:1
msgid "Powers connected Qwiic devices"
msgstr "A csatlakoztatott Qwiic eszközöket táplálja"

#: ../../openmvcam/shields/qwiic-shield.rst:1
