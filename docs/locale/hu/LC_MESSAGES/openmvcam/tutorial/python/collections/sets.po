msgid "add an item"
msgstr "elem hozzáadása"

#: ../../openmvcam/tutorial/python/collections/sets.rst:78
msgid "``s.add(x)``"
msgstr "``s.add(x)``"

#: ../../openmvcam/tutorial/python/collections/sets.rst:78
msgid "``d[k] = v``"
msgstr "``d[k] = v``"

