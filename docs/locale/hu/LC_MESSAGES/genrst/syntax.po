#: ../../genrst/syntax.rst:46
msgid "Operators"
msgstr "Operátorok"

#: ../../genrst/syntax.rst:51
msgid ""
"MicroPython allows using := to assign to the variable of a comprehension, "
"CPython raises a SyntaxError."
msgstr ""
"A MicroPython engedélyezi a := használatát egy listakifejezés változójához "
"való értékadásra, míg a CPython SyntaxError hibát jelez."

#: ../../genrst/syntax.rst:53
msgid ""
"**Cause:** MicroPython is optimised for code size and doesn't check this "
"case."
msgstr ""
"**Ok:** A MicroPython kódméret-optimalizálásra van tervezve, és nem "
"ellenőrzi ezt az esetet."

#: ../../genrst/syntax.rst:55
msgid ""
"**Workaround:** Do not rely on this behaviour if writing CPython compatible "
"code."
msgstr ""
"**Megkerülés:** Ne támaszkodjon erre a viselkedésre, ha CPython-kompatibilis"
" kódot ír."

#: ../../genrst/syntax.rst:73
msgid "Spaces"
msgstr "Szóközök"

#: ../../genrst/syntax.rst:78
msgid "uPy requires spaces between literal numbers and keywords, CPy doesn't"
msgstr ""
"A uPy szóközöket igényel a literál számok és kulcsszavak között, a CPy nem"

#: ../../genrst/syntax.rst:107
msgid "Unicode"
msgstr "Unicode"

#: ../../genrst/syntax.rst:112
msgid "Unicode name escapes are not implemented"
msgstr "A Unicode névmegszökítések nincsenek megvalósítva"
