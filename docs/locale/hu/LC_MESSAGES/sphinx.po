msgid "1-MP global-shutter colour + FLIR Lepton thermal on one module."
msgstr "1MP globális záras szín + FLIR Lepton hőkamera egy modulban."

msgid "1.8–5.5V battery input via a DC barrel jack."
msgstr "1,8–5,5V akkumulátor bemenet DC tápcsatlakozón keresztül."

msgid "10 Mb/s differential serial for industrial buses."
msgstr "10 Mb/s differenciális soros ipari buszokhoz."

msgid "10/100 Ethernet with Power-over-Ethernet."
msgstr "10/100 Ethernet Power-over-Ethernet funkcióval."

msgid "2.3\" SPI LCD with capacitive multi-touch and Qwiic."
msgstr "2,3\" SPI LCD kapacitív multi-touch érintővel és Qwiic csatlakozóval."

msgid "5MP HDR sensor — high dynamic range for tough lighting."
msgstr ""
"5MP HDR érzékelő — nagy dinamikatartomány nehéz megvilágítási "
"körülményekhez."

msgid "5MP rolling-shutter colour + FLIR Lepton thermal on one module."
msgstr "5MP gördülő záras szín + FLIR Lepton hőkamera egy modulban."

msgid "6µA standby motion trigger plus white and 850 nm IR."
msgstr "6µA készenléti mozgásérzékelő plusz fehér és 850 nm IR megvilágítás."

msgid "8 Mb/s CAN-FD plus 1 Mb/s RS-232 in one shield."
msgstr "8 Mb/s CAN-FD plusz 1 Mb/s RS-232 egy pajzsban."

msgid ""
"<code>find_blobs</code> returns connected pixel regions matching one or more"
" LAB thresholds."
msgstr ""
"<code>find_blobs</code> visszaadja az egy vagy több LAB küszöbértéknek "
"megfelelő összefüggő pixelrégiókat."

msgid ""
"<code>ml.utils.draw_skeleton</code> draws all 21 joints and connections in "
"one call."
msgstr ""
"<code>ml.utils.draw_skeleton</code> egyetlen hívásban rajzolja meg mind a 21"
" ízületet és azok kapcsolatait."

msgid ""
"<code>pixels_threshold</code> filters tiny detections; "
"<code>merge=True</code> joins overlapping blobs."
msgstr ""
"<code>pixels_threshold</code> kiszűri az apró felismeréseket; "
"<code>merge=True</code> összekapcsolja az átfedő foltokat."

msgid "API"
msgstr "API"

msgid "API reference"
msgstr "API referencia"

msgid "Adapter for FLIR Boson / Boson+ — higher-resolution thermal."
msgstr "Adapter FLIR Boson / Boson+ számára — nagyobb felbontású hőkép."

msgid "Adapter for FLIR Lepton 1.x / 2.x / 3.x thermal cores."
msgstr "Adapter FLIR Lepton 1.x / 2.x / 3.x hőkamera magokhoz."

msgid ""
"Add-on boards that plug into the OpenMV Cam — networking, motor control, "
"displays, and more."
msgstr ""
"Az OpenMV Cam-hez csatlakoztatható bővítő lapok — hálózatkezelés, "
"motormeghajtás, kijelzők és még sok más."

msgid "Add-ons"
msgstr "Bővítmények"

msgid "Alif Ensemble E3 — fusion-class Cortex-M55 with Ethos-U55 NPU."
msgstr "Alif Ensemble E3 — fusion osztályú Cortex-M55 Ethos-U55 NPU-val."

msgid "AprilTag tracking"
msgstr "AprilTag követés"

msgid ""
"AprilTags are 2D fiducial markers — robust to motion blur and partial "
"occlusion, and they give you full 3D pose."
msgstr ""
"Az AprilTag-ek 2D referencia markerek — mozgási elmosódással és részleges "
"takarással szemben robusztusak, és teljes 3D-s pozíciót adnak."

msgid "Async Bluetooth Low Energy — peripherals, advertising, and GATT."
msgstr "Aszinkron Bluetooth Low Energy — perifériák, hirdetés és GATT."

msgid "Back to top"
msgstr "Vissza az elejére"

msgid "Bar code detection"
msgstr "Vonalkód felismerés"

msgid "BlazeFace tracking"
msgstr "BlazeFace követés"

msgid "Boards"
msgstr "Lapkák"

msgid ""
"Bring your own YOLOv8 model trained on <a "
"href=\"https://roboflow.com\">Roboflow</a> and load it the same way."
msgstr ""
"Hozza saját YOLOv8 modelljét, amelyet a <a "
"href=\"https://roboflow.com\">Roboflow</a> segítségével tanított, és töltse "
"be ugyanúgy."

msgid "Built-in detector — no model file or training needed."
msgstr "Beépített detektor — nincs szükség modell fájlra vagy tanításra."

msgid ""
"Camera control: pixel formats, frame sizes, exposure, gain, and white "
"balance."
msgstr ""
"Kameravezérlés: pixelformátumok, képkockaméret, expozíció, erősítés és "
"fehéregyensúly."

msgid "Camera modules"
msgstr "Kameramodulok"

msgid ""
"Camera modules and sensor adapters that plug into the board-to-board "
"connector — colour, monochrome, thermal, and event-based vision."
msgstr ""
"Kameramodulok és érzékelő adapterek, amelyek a lap-lap csatlakozóba dughatók"
" — színes, monokróm, hőkamerás és eseményalapú látás."

msgid "Changelog"
msgstr "Változásnapló"

msgid ""
"Click the socket-icon connect button in the IDE, then hit the green play "
"arrow to run your first script."
msgstr ""
"Kattintson a csatlakozás gombra az IDE-ben, majd nyomja meg a zöld lejátszás"
" nyilat az első szkript futtatásához."

msgid "Color tracking"
msgstr "Színkövetés"

msgid "Community &amp; links"
msgstr "Közösség &amp; linkek"

msgid "Community discussion, help, and project sharing."
msgstr "Közösségi megbeszélés, segítség és projektmegosztás."

msgid "Compact 23 × 23 mm STM32H747 board with on-board sensor."
msgstr "Kompakt 23 × 23 mm-es STM32H747 lap beépített érzékelővel."

msgid ""
"Compiler, runtime, native modules, and porting MicroPython to new MCUs."
msgstr ""
"Fordítóprogram, futásidő, natív modulok és a MicroPython portolása új MCU-"
"kra."

msgid "Connect your cam"
msgstr "Csatlakoztassa a kameráját"

msgid "Cooperative multitasking — run camera, network, and I/O in parallel."
msgstr ""
"Kooperatív többfeladatos végrehajtás — kamera, hálózat és I/O párhuzamos "
"futtatása."

msgid "Copy page"
msgstr "Lap másolása"

msgid "Core libraries"
msgstr "Alapkönyvtárak"

msgid "Detect faces with BlazeFace"
msgstr "Arcfelismerés BlazeFace segítségével"

msgid "Differences from CPython"
msgstr "Különbségek a CPython-tól"

msgid "Discussion"
msgstr "Megbeszélés"

msgid ""
"Download and install OpenMV IDE for Windows, macOS, or Linux and launch the "
"IDE."
msgstr ""
"Töltse le és telepítse az OpenMV IDE-t Windows, macOS vagy Linux rendszerre,"
" majd indítsa el az IDE-t."

msgid ""
"Drive up to 4 servos drawing up to 5A while powering the camera, 6–36V "
"input."
msgstr ""
"Legfeljebb 4 szervomotor meghajtása legfeljebb 5A áramfelvétellel, miközben "
"táplálja a kamerát, 6–36V bemenet."

msgid "Each result also exposes version, ECC level, and corner coordinates."
msgstr ""
"Minden eredmény tartalmazza a verziót, az ECC szintet és a "
"sarokkoordinátákat."

msgid ""
"Each result has format, payload, rotation, corners, and a bounding rect."
msgstr ""
"Minden eredmény tartalmaz formátumot, tartalmat, forgatást, sarkokat és "
"befoglaló téglalapot."

msgid "Edit this page"
msgstr "Lap szerkesztése"

msgid "Examples"
msgstr "Példák"

msgid "Explore by board"
msgstr "Felfedezés lap szerint"

msgid "Explore →"
msgstr "Fedezze fel →"

msgid "External"
msgstr "Külső"

msgid "Find 1D barcodes anywhere in the frame and decode their payloads."
msgstr ""
"Keressen 1D vonalkódokat bárhol a képkockában és dekódolja azok tartalmát."

msgid "Find blobs of color"
msgstr "Színes foltok keresése"

msgid "Find your board"
msgstr "Találja meg a lapját"

msgid "Firmware, IDE, and example sources — issues and pull requests welcome."
msgstr ""
"Firmware, IDE és példa források — hibák és pull requestek szívesen fogadva."

#, python-format
msgid ""
"For OpenMV firmware v%(omv)s &middot; based on MicroPython v%(mpy)s &middot;"
" docs built %(date)s &middot; Copyright &copy; 2014-2026 by OpenMV, Damien "
"P. George, and others."
msgstr ""
"OpenMV firmware v%(omv)s &middot; MicroPython v%(mpy)s alapján &middot; "
"dokumentáció elkészítve %(date)s &middot; Szerzői jog &copy; 2014-2026 "
"OpenMV, Damien P. George és mások."

#, python-format
msgid ""
"For OpenMV firmware v%(omv)s · based on MicroPython v%(mpy)s · docs built "
"%(date)s"
msgstr ""
"OpenMV firmware v%(omv)s · MicroPython v%(mpy)s alapján · dokumentáció "
"építve: %(date)s"

msgid "Forums"
msgstr "Fórumok"

msgid "GENX320 event sensor + PAG7936 colour on one module."
msgstr "GENX320 eseményérzékelő + PAG7936 szín egy modulban."

msgid "Gigabit Ethernet with PoE for higher-bandwidth streaming."
msgstr "Gigabites Ethernet PoE-vel a nagyobb sávszélességű streaminghez."

msgid ""
"Google's BlazeFace is a lightweight TensorFlow Lite face detector that "
"returns bounding boxes plus six landmarks per face."
msgstr ""
"A Google BlazeFace egy könnyűsúlyú TensorFlow Lite arcfelismerő, amely "
"befoglaló téglalapokat és hat mérföldkövet ad vissza arconként."

msgid ""
"Google's MediaPipe Hand Landmarks model places 21 joints on each detected "
"hand — wrist, knuckles, and fingertips."
msgstr ""
"A Google MediaPipe Hand Landmarks modell 21 ízületet helyez el minden "
"felismert kézen — csukló, ujjpercek és ujjhegyek."

msgid "Hand landmarks"
msgstr "Kéz mérföldkövek"

msgid "Hardware"
msgstr "Hardver"

msgid ""
"Hardware, cameras, image processing, ndarrays, ML, multitasking, networking,"
" web servers, and Bluetooth — all from MicroPython."
msgstr ""
"Hardver, kamerák, képfeldolgozás, ndarray-ok, ML, többfeladatos végrehajtás,"
" hálózatkezelés, webszerverek és Bluetooth — mind MicroPython-ból."

msgid "Hello world"
msgstr "Hello world"

msgid "Home"
msgstr "Kezdőlap"

msgid "Internals"
msgstr "Belső felépítés"

msgid "Language"
msgstr "Nyelv"

msgid "Language reference, syntax, and core runtime semantics."
msgstr "Nyelvi referencia, szintaxis és alapvető futásidejű szemantika."

msgid "Libraries"
msgstr "Alapkönyvtárak"

msgid "License"
msgstr "Licenc"

msgid ""
"Live face detection, AprilTag tracking, QR scanning, and YOLO. All on-device"
" in pure MicroPython. No host computer, no cloud."
msgstr ""
"Élő arcfelismerés, AprilTag követés, QR szkennelés és YOLO. Minden az "
"eszközön, tiszta MicroPython-ban. Nincs szükség gazdagépre vagy felhőre."

msgid ""
"Loaded from <code>/rom/blazeface_front_128.tflite</code> — pre-quantised, no"
" download needed."
msgstr ""
"Betöltve a <code>/rom/blazeface_front_128.tflite</code> fájlból — előre "
"kvantált, nincs szükség letöltésre."

msgid ""
"Loaded from <code>/rom/hand_landmarks_full_224.tflite</code> — running "
"standalone here, without palm detection upstream."
msgstr ""
"Betöltve a <code>/rom/hand_landmarks_full_224.tflite</code> fájlból — itt "
"önállóan fut, tenyérfelismerés nélkül."

msgid ""
"Loaded from <code>/rom/yolov8n_192.tflite</code> — no SD card or download "
"needed."
msgstr ""
"Betöltve a <code>/rom/yolov8n_192.tflite</code> fájlból — nincs szükség SD "
"kártyára vagy letöltésre."

msgid "Locate and identify AprilTags"
msgstr "AprilTag-ek megkeresése és azonosítása"

msgid "Low-level hardware: GPIO, SPI, I²C, UART, PWM, ADC, and timers."
msgstr "Alacsony szintű hardver: GPIO, SPI, I²C, UART, PWM, ADC és időzítők."

msgid "Machine vision,<br>made simple."
msgstr "Gépi látás,<br>egyszerűen."

msgid "Machine vision: blobs, edges, lines, circles, features, and drawing."
msgstr "Gépi látás: foltok, élek, vonalak, körök, jellemzők és rajzolás."

msgid ""
"Made with <a href=\"https://www.sphinx-doc.org/\">Sphinx</a> using the <a "
"href=\"https://shibuya.lepture.com\">Shibuya theme</a>."
msgstr ""
"Készítve <a href=\"https://www.sphinx-doc.org/\">Sphinx</a> segítségével a "
"<a href=\"https://shibuya.lepture.com\">Shibuya theme</a> használatával."

msgid "Made with the <a href=\"https://shibuya.lepture.com\">Shibuya theme</a>."
msgstr ""
"Készítve a <a href=\"https://shibuya.lepture.com\">Shibuya theme</a> "
"segítségével."

msgid "MicroPython on GitHub"
msgstr "MicroPython a GitHub-on"

msgid "Minimal HTTP server — routes, sessions, login, SSE, and WebSockets."
msgstr ""
"Minimális HTTP szerver — útvonalak, munkamenetek, bejelentkezés, SSE és "
"WebSocketek."

msgid "Monochrome global-shutter sensor for fast-motion capture."
msgstr "Monokróm globális záras érzékelő gyors mozgás rögzítéséhez."

msgid "More actions"
msgstr "További műveletek"

msgid "More resources"
msgstr "További erőforrások"

msgid "NXP i.MX RT1062 Cortex-M7 at 600 MHz with 32 MB external SDRAM."
msgstr "NXP i.MX RT1062 Cortex-M7 600 MHz-en 32 MB külső SDRAM-mal."

msgid "New"
msgstr "Új"

msgid "New to OpenMV?"
msgstr "Új az OpenMV-nél?"

msgid "Next"
msgstr "Következő"

msgid "No privacy concerns — frames never leave the camera."
msgstr "Nincs adatvédelmi aggály — a képkockák soha nem hagyják el a kamerát."

msgid "Numeric, alphanumeric, binary, and Kanji data modes."
msgstr "Numerikus, alfanumerikus, bináris és Kanji adatmódok."

msgid "On this page"
msgstr "Ezen az oldalon"

msgid "On-device neural network inference — classify, detect, and segment."
msgstr ""
"Eszközön végzett neurális hálózati következtetés — osztályozás, felismerés "
"és szegmentálás."

msgid "On-device numerical computing — ndarrays, FFTs, and linear algebra."
msgstr ""
"Eszközön végzett numerikus számítás — ndarray-ok, FFT-k és lineáris algebra."

msgid "Open in ChatGPT"
msgstr "Megnyitás ChatGPT-ben"

msgid "Open in Claude"
msgstr "Megnyitás Claude-ban"

msgid "Open in Perplexity"
msgstr "Megnyitás Perplexityben"

msgid "Open the IDE"
msgstr "Nyissa meg az IDE-t"

msgid "OpenMV MicroPython internals"
msgstr "OpenMV MicroPython belső működés"

msgid "OpenMV MicroPython language"
msgstr "OpenMV MicroPython nyelv"

msgid "OpenMV homepage"
msgstr "OpenMV főoldal"

msgid "OpenMV on GitHub"
msgstr "OpenMV a GitHub-on"

msgid "Overview"
msgstr "Áttekintés"

msgid "Pass multiple thresholds for multi-color tracking in one call."
msgstr ""
"Adjon meg több küszöbértéket a többszínű követéshez egyetlen hívásban."

msgid ""
"Plug the OpenMV Cam into your computer via USB. A blue heartbeat LED blinks "
"when it's ready."
msgstr ""
"Csatlakoztassa az OpenMV Cam-et a számítógépéhez USB-en keresztül. Egy kék "
"szívverés LED villog, amikor készen áll."

msgid ""
"Powered by the <a href=\"https://github.com/mchehab/zbar\">ZBar</a> library "
"— recognises EAN, UPC, Code&nbsp;39/93/128, Codabar, ITF, ISBN, and DataBar."
msgstr ""
"A <a href=\"https://github.com/mchehab/zbar\">ZBar</a> könyvtár hajtja — "
"felismeri az EAN, UPC, Code&nbsp;39/93/128, Codabar, ITF, ISBN és DataBar "
"kódokat."

msgid "Previous"
msgstr "Előző"

msgid "Products, applications, downloads, and news."
msgstr "Termékek, alkalmazások, letöltések és hírek."

msgid "Prophesee event-based vision — microsecond temporal precision."
msgstr "Prophesee eseményalapú látás — mikroszekundumos időbeli pontosság."

msgid "QR code detection"
msgstr "QR kód felismerés"

msgid "Quick start guide"
msgstr "Gyors üzembe helyezési útmutató"

msgid "Read 1D barcodes"
msgstr "1D vonalkódok olvasása"

#, python-format
msgid "Read the OpenMV firmware <strong>v%(v)s</strong> changelog"
msgstr ""
"Olvassa el az OpenMV firmware <strong>v%(v)s</strong> változásnaplóját"

msgid "Real-time person tracking"
msgstr "Valós idejű személykövetés"

msgid ""
"Returns ID plus full 6-DoF pose — <code>x/y/z</code> translation and "
"<code>x/y/z</code> rotation."
msgstr ""
"Visszaadja az azonosítót és a teljes 6-DoF pozíciót — <code>x/y/z</code> "
"eltolás és <code>x/y/z</code> forgás."

msgid "Returns one list per hand — index 0 is left, index 1 is right."
msgstr ""
"Kézenként egy listát ad vissza — a 0. index a bal, az 1. index a jobb kéz."

msgid "Returns the decoded payload as a Python string — ready to use."
msgstr ""
"A dekódolt adatot Python karakterláncként adja vissza — azonnal használható."

msgid "Run your first script"
msgstr "Futtassa az első szkriptjét"

msgid "Runs in real time on NPU-equipped boards — the OpenMV N6 and AE3."
msgstr ""
"Valós időben fut NPU-val felszerelt lapokon — az OpenMV N6-on és AE3-on."

msgid "STM32H743 Cortex-M7 with a removable image sensor module."
msgstr "STM32H743 Cortex-M7 cserélhető képérzékelő modullal."

msgid "STM32H743 with 32 MB external SDRAM and a 5MP OV5640 sensor."
msgstr "STM32H743 32 MB külső SDRAM-mal és 5MP OV5640 érzékelővel."

msgid "STM32H747 with 8 MB SDRAM and Vision Shield support."
msgstr "STM32H747 8 MB SDRAM-mal és Vision Shield támogatással."

msgid "STM32H747 with 8 MB SDRAM, Vision and Display Shield support."
msgstr "STM32H747 8 MB SDRAM-mal, Vision és Display Shield támogatással."

msgid "STM32N6 with built-in NPU — STMicro's first AI-accelerated MCU."
msgstr "STM32N6 beépített NPU-val — az STMicro első AI-gyorsított MCU-ja."

msgid "Scan QR codes from a live feed"
msgstr "QR kódok szkennelése élő adatfolyamból"

msgid ""
"Select your OpenMV Cam to see its pinout, specs, and board-specific quick "
"reference."
msgstr ""
"Válassza ki az OpenMV Cam-jét a lábkiosztás, specifikációk és lapspecifikus "
"gyors referencia megtekintéséhez."

msgid "Sensors"
msgstr "Érzékelők"

msgid "Shields"
msgstr "Pajzsok"

msgid "Six keypoints per face: eyes, nose, mouth, and ears."
msgstr "Hat kulcspont arconként: szemek, orr, száj és fülek."

msgid ""
"Start with the step-by-step tutorial — it covers hardware setup, the IDE, "
"basic scripts, and tips for your first real project."
msgstr ""
"Kezdje a lépésről lépésre haladó útmutatóval — lefedi a hardver beállítását,"
" az IDE-t, az alapvető szkripteket és tippeket az első valódi projekthez."

msgid "Switch to auto color mode"
msgstr "Váltás automatikus színmódra"

msgid "Switch to dark color mode"
msgstr "Váltás sötét színmódra"

msgid "Switch to light color mode"
msgstr "Váltás világos színmódra"

msgid ""
"The built-in QR decoder handles tilted, distorted, and partially occluded "
"codes."
msgstr ""
"A beépített QR dekóder kezeli a döntött, torzított és részben takart "
"kódokat."

msgid ""
"The on-board YOLOv8 model is a single-class person detector — int8 quantised"
" and shipped in ROM."
msgstr ""
"A beépített YOLOv8 modell egyosztályos személydetektor — int8 kvantált és "
"ROM-ban szállított."

msgid "Track 21 hand keypoints"
msgstr "21 kéz kulcspont követése"

msgid "Translations"
msgstr "Fordítások"

msgid ""
"Tune thresholds for your lighting — disable auto-gain and auto-whitebal "
"first."
msgstr ""
"Hangolja a küszöbértékeket a megvilágításhoz — először tiltsa le az "
"automatikus erősítést és fehéregyensúlyt."

msgid "Tutorial"
msgstr "Útmutató"

msgid "Upstream MicroPython firmware sources — what OpenMV builds on top of."
msgstr "Az upstream MicroPython firmware forrásai — amire az OpenMV épül."

msgid "Use a windowed strip in grayscale for the fastest linear scan."
msgstr ""
"Használjon szürkeárnyalatos ablakos sávot a leggyorsabb lineáris "
"szkenneléshez."

msgid "Use for robotics calibration, AR markers, and indoor positioning."
msgstr ""
"Robotikai kalibráláshoz, AR jelölőkhöz és beltéri pozicionáláshoz "
"használható."

msgid "Versions"
msgstr "Verziók"

msgid "View Source"
msgstr "Forrás megtekintése"

msgid "View all libraries →"
msgstr "Az összes könyvtár megtekintése →"

msgid "View all sensors →"
msgstr "Az összes érzékelő megtekintése →"

msgid "View all shields →"
msgstr "Az összes pajzs megtekintése →"

msgid "View all supported boards →"
msgstr "Az összes támogatott lap megtekintése →"

msgid "View as Markdown"
msgstr "Megtekintés Markdown-ként"

msgid "What's new"
msgstr "Mi az újdonság"

msgid ""
"Where MicroPython diverges from standard Python — modules, builtins, and "
"syntax."
msgstr ""
"Ahol a MicroPython eltér a standard Python-tól — modulok, beépített elemek "
"és szintaxis."

msgid "Wi-Fi, Ethernet, and sockets for IoT and remote communication."
msgstr "Wi-Fi, Ethernet és socketek IoT és távoli kommunikációhoz."

msgid "YOLOv8 person tracking"
msgstr "YOLOv8 személykövetés"
