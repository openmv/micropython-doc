#: ../../legacy/cmucam3/cmucam2-emulation.rst:63
msgid "HT Set Histogram Track (not supported)"
msgstr "HT hisztogramkövetés beállítása (nem támogatott)"

#: ../../legacy/cmucam3/cmucam2-emulation.rst:64
