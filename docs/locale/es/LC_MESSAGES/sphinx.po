msgstr ""
"Referencia del lenguaje, sintaxis y semántica básica del tiempo de "
"ejecución."

msgid "Libraries"
msgstr "Bibliotecas principales"

msgid "License"
msgstr "Licencia"

msgid ""
"Live face detection, AprilTag tracking, QR scanning, and YOLO. All on-device"
" in pure MicroPython. No host computer, no cloud."
msgstr ""
"Detección de rostros en vivo, seguimiento de AprilTag, lectura de QR y YOLO."
" Todo en el dispositivo con puro MicroPython. Sin ordenador host, sin nube."

msgid ""
"Loaded from <code>/rom/blazeface_front_128.tflite</code> — pre-quantised, no"
" download needed."
msgstr ""
"Cargado desde <code>/rom/blazeface_front_128.tflite</code> — "
"precuantificado, no se necesita descarga."

msgid ""
"Loaded from <code>/rom/hand_landmarks_full_224.tflite</code> — running "
"standalone here, without palm detection upstream."
msgstr ""
"Cargado desde <code>/rom/hand_landmarks_full_224.tflite</code> — se ejecuta "
"de forma independiente aquí, sin detección de palma previa."

msgid ""
"Loaded from <code>/rom/yolov8n_192.tflite</code> — no SD card or download "
"needed."
msgstr ""
"Cargado desde <code>/rom/yolov8n_192.tflite</code> — no se necesita tarjeta "
"SD ni descarga."

msgid "Locate and identify AprilTags"
msgstr "Localiza e identifica AprilTags"

msgid "Low-level hardware: GPIO, SPI, I²C, UART, PWM, ADC, and timers."
msgstr ""
"Hardware de bajo nivel: GPIO, SPI, I²C, UART, PWM, ADC y temporizadores."

msgid "Machine vision,<br>made simple."
msgstr "Visión artificial,<br>simplificada."

msgid "Machine vision: blobs, edges, lines, circles, features, and drawing."
msgstr ""
"Visión artificial: manchas, bordes, líneas, círculos, características y "
"dibujo."

