msgid "One of:"
msgstr "Uno de:"

#: ../../library/ubluepy.rst:87
msgid "``int`` --- a 16-bit numeric UUID (``UUID(0x180A)``)."
msgstr "``int`` --- un UUID numérico de 16 bits (``UUID(0x180A)``)."

#: ../../library/ubluepy.rst:88
msgid ""
"6-character ``\"0xXXXX\"`` string --- a 16-bit UUID, e.g. "
"``UUID(\"0x181A\")``."
msgstr ""
"Cadena ``\"0xXXXX\"`` de 6 caracteres --- un UUID de 16 bits, p. ej. "
