#: ../../library/pyb.rst:260
msgid "Return a 30-bit hardware generated random number."
msgstr "Devuelve un número aleatorio generado por hardware de 30 bits."

#: ../../library/pyb.rst:264
msgid "Sync all file systems."
msgstr "Sincroniza todos los sistemas de archivos."

#: ../../library/pyb.rst:268
msgid ""
"Returns a string of 12 bytes (96 bits), which is the unique ID of the MCU."
msgstr "Devuelve una cadena de 12 bytes (96 bits) que es el ID único del MCU."

#: ../../library/pyb.rst:272
msgid "If called with no arguments, return the current USB mode as a string."
msgstr ""
"Si se llama sin argumentos, devuelve el modo USB actual como una cadena."

#: ../../library/pyb.rst:274
