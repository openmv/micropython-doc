msgid "Magnet-for-gyroscope fusion mode (``0x0A``)."
msgstr "Modo de fusión de magnetómetro como giroscopio (``0x0A``)."

#: ../../library/omv.bno055.rst:193
msgid ""
"9-DOF fusion mode with fast magnetometer calibration disabled (``0x0B``)."
msgstr ""
"Modo de fusión de 9 grados de libertad con la calibración rápida del "
