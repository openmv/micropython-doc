msgid "Constants"
msgstr "Constantes"

#: ../../library/omv.tof.rst:233
msgid "VL53L5CX or VL53L8CX TOF sensor (8x8 pixels)."
msgstr "Sensor TOF VL53L5CX o VL53L8CX (8x8 píxeles)."
