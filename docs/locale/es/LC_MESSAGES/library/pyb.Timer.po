msgid "Capture on the rising edge."
msgstr "Captura en el flanco ascendente."

#: ../../library/pyb.Timer.rst:370
msgid "Capture on the falling edge."
msgstr "Captura en el flanco descendente."

#: ../../library/pyb.Timer.rst:375
