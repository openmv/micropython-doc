#: ../../library/omv.sensor.rst:874
msgid "Set the sensor readout window. See `sensor.ioctl()`."
msgstr ""
"Establece la ventana de lectura del sensor. Consulte `sensor.ioctl()`."

#: ../../library/omv.sensor.rst:879
msgid "Get the sensor readout window. See `sensor.ioctl()`."
msgstr "Obtiene la ventana de lectura del sensor. Consulte `sensor.ioctl()`."

#: ../../library/omv.sensor.rst:884
msgid "Set triggered mode (e.g. for the MT9V034). See `sensor.ioctl()`."
msgstr ""
"Establece el modo activado por disparo (por ejemplo, para la MT9V034). "
"Consulte `sensor.ioctl()`."

#: ../../library/omv.sensor.rst:889
msgid "Get the current triggered-mode state. See `sensor.ioctl()`."
msgstr ""
"Obtiene el estado actual del modo activado por disparo. Consulte "
"`sensor.ioctl()`."

#: ../../library/omv.sensor.rst:894
msgid ""
"Optimize `sensor.set_framesize()` for field-of-view over FPS. See "
"`sensor.ioctl()`."
msgstr ""
"Optimiza `sensor.set_framesize()` para el campo de visión frente a los FPS. "
"Consulte `sensor.ioctl()`."

#: ../../library/omv.sensor.rst:900
msgid ""
"Get the current field-of-view-over-FPS optimization state. See "
"`sensor.ioctl()`."
msgstr ""
"Obtiene el estado actual de la optimización de campo de visión frente a FPS."
" Consulte `sensor.ioctl()`."

#: ../../library/omv.sensor.rst:906
msgid ""
"Trigger auto focus on the OV5640 FPC camera module. See `sensor.ioctl()`."
msgstr ""
"Dispara el enfoque automático en el módulo de cámara OV5640 FPC. Consulte "
"`sensor.ioctl()`."

#: ../../library/omv.sensor.rst:911
msgid ""
"Pause auto focus on the OV5640 FPC camera module. See `sensor.ioctl()`."
msgstr ""
"Pausa el enfoque automático en el módulo de cámara OV5640 FPC. Consulte "
"`sensor.ioctl()`."

#: ../../library/omv.sensor.rst:916
msgid ""
"Reset auto focus on the OV5640 FPC camera module. See `sensor.ioctl()`."
msgstr ""
"Restablece el enfoque automático en el módulo de cámara OV5640 FPC. Consulte"
" `sensor.ioctl()`."

#: ../../library/omv.sensor.rst:921
msgid ""
"Wait on auto focus to complete on the OV5640 FPC camera module. See "
"`sensor.ioctl()`."
msgstr ""
"Espera a que se complete el enfoque automático en el módulo de cámara OV5640"
" FPC. Consulte `sensor.ioctl()`."

#: ../../library/omv.sensor.rst:927
msgid "Enable/disable night mode on the sensor. See `sensor.ioctl()`."
msgstr ""
"Habilita/deshabilita el modo nocturno en el sensor. Consulte "
"`sensor.ioctl()`."

#: ../../library/omv.sensor.rst:932
msgid "Get the current night-mode state. See `sensor.ioctl()`."
msgstr ""
"Obtiene el estado actual del modo nocturno. Consulte `sensor.ioctl()`."

#: ../../library/omv.sensor.rst:937
msgid "Get the FLIR Lepton image width in pixels. See `sensor.ioctl()`."
msgstr ""
"Obtiene el ancho de la imagen del FLIR Lepton en píxeles. Consulte "
"`sensor.ioctl()`."

#: ../../library/omv.sensor.rst:942
msgid "Get the FLIR Lepton image height in pixels. See `sensor.ioctl()`."
msgstr ""
"Obtiene la altura de la imagen del FLIR Lepton en píxeles. Consulte "
"`sensor.ioctl()`."

#: ../../library/omv.sensor.rst:947
msgid "Get the FLIR Lepton type (radiometric or not). See `sensor.ioctl()`."
msgstr ""
"Obtiene el tipo del FLIR Lepton (radiométrico o no). Consulte "
"`sensor.ioctl()`."

#: ../../library/omv.sensor.rst:952
msgid "Get the FLIR Lepton refresh rate in Hz. See `sensor.ioctl()`."
msgstr ""
"Obtiene la frecuencia de refresco del FLIR Lepton en Hz. Consulte "
"`sensor.ioctl()`."

#: ../../library/omv.sensor.rst:957
msgid "Get the FLIR Lepton ADC resolution in bits. See `sensor.ioctl()`."
msgstr ""
"Obtiene la resolución del ADC del FLIR Lepton en bits. Consulte "
"`sensor.ioctl()`."

#: ../../library/omv.sensor.rst:962
msgid "Execute a 16-bit FLIR Lepton SDK command. See `sensor.ioctl()`."
msgstr ""
"Ejecuta un comando de 16 bits del SDK de FLIR Lepton. Consulte "
"`sensor.ioctl()`."

#: ../../library/omv.sensor.rst:967
msgid "Set a FLIR Lepton attribute. See `sensor.ioctl()`."
msgstr "Establece un atributo del FLIR Lepton. Consulte `sensor.ioctl()`."

#: ../../library/omv.sensor.rst:972
msgid "Get a FLIR Lepton attribute. See `sensor.ioctl()`."
msgstr "Obtiene un atributo del FLIR Lepton. Consulte `sensor.ioctl()`."

#: ../../library/omv.sensor.rst:977
msgid "Get the FLIR Lepton FPA temperature in celsius. See `sensor.ioctl()`."
msgstr ""
"Obtiene la temperatura del FPA del FLIR Lepton en grados Celsius. Consulte "
"`sensor.ioctl()`."

#: ../../library/omv.sensor.rst:982
msgid "Get the FLIR Lepton AUX temperature in celsius. See `sensor.ioctl()`."
msgstr ""
"Obtiene la temperatura AUX del FLIR Lepton en grados Celsius. Consulte "
"`sensor.ioctl()`."

#: ../../library/omv.sensor.rst:987
msgid "Set FLIR Lepton measurement mode. See `sensor.ioctl()`."
msgstr ""
"Establece el modo de medición del FLIR Lepton. Consulte `sensor.ioctl()`."

#: ../../library/omv.sensor.rst:992
msgid "Get FLIR Lepton measurement-mode state. See `sensor.ioctl()`."
msgstr ""
"Obtiene el estado del modo de medición del FLIR Lepton. Consulte "
"`sensor.ioctl()`."

#: ../../library/omv.sensor.rst:997
msgid ""
"Set the FLIR Lepton measurement-mode temperature range. See "
"`sensor.ioctl()`."
msgstr ""
"Establece el rango de temperatura del modo de medición del FLIR Lepton. "
"Consulte `sensor.ioctl()`."

#: ../../library/omv.sensor.rst:1002
msgid ""
"Get the FLIR Lepton measurement-mode temperature range. See "
"`sensor.ioctl()`."
msgstr ""
"Obtiene el rango de temperatura del modo de medición del FLIR Lepton. "
"Consulte `sensor.ioctl()`."

#: ../../library/omv.sensor.rst:1007
msgid "Enable/disable HM01B0 motion detection. See `sensor.ioctl()`."
msgstr ""
"Habilita/deshabilita la detección de movimiento del HM01B0. Consulte "
"`sensor.ioctl()`."

#: ../../library/omv.sensor.rst:1012
msgid "Set the HM01B0 motion detection window. See `sensor.ioctl()`."
msgstr ""
"Establece la ventana de detección de movimiento del HM01B0. Consulte "
"`sensor.ioctl()`."

#: ../../library/omv.sensor.rst:1017
msgid "Set the HM01B0 motion detection threshold. See `sensor.ioctl()`."
msgstr ""
"Establece el umbral de detección de movimiento del HM01B0. Consulte "
"`sensor.ioctl()`."

#: ../../library/omv.sensor.rst:1022
msgid "Clear the HM01B0 motion detection interrupt. See `sensor.ioctl()`."
msgstr ""
"Borra la interrupción de detección de movimiento del HM01B0. Consulte "
"`sensor.ioctl()`."

#: ../../library/omv.sensor.rst:1027
msgid "Enable/disable the HM01B0 internal oscillator. See `sensor.ioctl()`."
msgstr ""
"Habilita/deshabilita el oscilador interno del HM01B0. Consulte "
"`sensor.ioctl()`."

#: ../../library/omv.sensor.rst:1032
msgid ""
"Get the ``(r, gb, gr, b)`` RGB statistics from the sensor. See "
"`sensor.ioctl()`."
msgstr ""
"Obtiene las estadísticas RGB ``(r, gb, gr, b)`` del sensor. Consulte "
"`sensor.ioctl()`."

#: ../../library/omv.sensor.rst:1038
