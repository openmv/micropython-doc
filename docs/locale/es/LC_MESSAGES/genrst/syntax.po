#: ../../genrst/syntax.rst:46
msgid "Operators"
msgstr "Operadores"

#: ../../genrst/syntax.rst:51
msgid ""
"MicroPython allows using := to assign to the variable of a comprehension, "
"CPython raises a SyntaxError."
msgstr ""
"MicroPython permite usar := para asignar a la variable de una comprensión; "
"CPython lanza un SyntaxError."

#: ../../genrst/syntax.rst:53
msgid ""
"**Cause:** MicroPython is optimised for code size and doesn't check this "
"case."
msgstr ""
"**Causa:** MicroPython está optimizado para el tamaño del código y no "
"verifica este caso."

#: ../../genrst/syntax.rst:55
msgid ""
"**Workaround:** Do not rely on this behaviour if writing CPython compatible "
"code."
msgstr ""
"**Solución:** No dependa de este comportamiento si escribe código compatible"
" con CPython."

#: ../../genrst/syntax.rst:73
msgid "Spaces"
msgstr "Espacios"

#: ../../genrst/syntax.rst:78
msgid "uPy requires spaces between literal numbers and keywords, CPy doesn't"
msgstr ""
"uPy requiere espacios entre números literales y palabras clave, CPy no"

#: ../../genrst/syntax.rst:107
msgid "Unicode"
msgstr "Unicode"

#: ../../genrst/syntax.rst:112
msgid "Unicode name escapes are not implemented"
msgstr "Los escapes de nombre Unicode no están implementados"
