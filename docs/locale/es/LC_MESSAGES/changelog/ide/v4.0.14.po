msgid "v4.0.14"
msgstr "v4.0.14"

#: ../../changelog/ide/v4.0.14.rst:6
msgid ""
"v4.0.14 is a maintenance release built on Qt Creator 10.0.1. It carries "
"internal updates only, with no user-facing feature, behavior, or workflow "
"changes, and no breaking changes."
msgstr ""
"v4.0.14 es una versión de mantenimiento construida sobre Qt Creator 10.0.1. "
"Incorpora únicamente actualizaciones internas, sin cambios de "
"característica, comportamiento o flujo de trabajo visibles para el usuario, "
"y sin cambios incompatibles."

#: ../../changelog/ide/v4.0.14.rst:13
msgid "On this page"
msgstr "En esta página"

#: ../../changelog/ide/v4.0.14.rst:16
msgid "Highlights"
msgstr "Aspectos destacados"

#: ../../changelog/ide/v4.0.14.rst:18
msgid ""
"**Maintenance release** with internal updates only; no user-facing changes."
msgstr ""
"**Versión de mantenimiento** con únicamente actualizaciones internas; sin "
"cambios visibles para el usuario."

#: ../../changelog/ide/v4.0.14.rst:22
msgid "Platform and tool support"
msgstr "Soporte de plataformas y herramientas"

