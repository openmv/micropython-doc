#: ../../changelog/firmware/v4.1.4.rst:4
msgid "v4.1.4"
msgstr "v4.1.4"

#: ../../changelog/firmware/v4.1.4.rst:6
msgid ""
"v4.1.4 is a maintenance release that updates the bundled MicroPython "
"submodule. It introduces **no breaking API changes** — v4.1.3 scripts run "
"unchanged."
msgstr ""
"v4.1.4 es una versión de mantenimiento que actualiza el submódulo de "
"MicroPython incluido. No introduce **ningún cambio incompatible en la API** "
"— los scripts de v4.1.3 se ejecutan sin cambios."

#: ../../changelog/firmware/v4.1.4.rst:13
msgid "On this page"
msgstr "En esta página"

#: ../../changelog/firmware/v4.1.4.rst:16
msgid "Highlights"
msgstr "Aspectos destacados"

#: ../../changelog/firmware/v4.1.4.rst:18
msgid "**MicroPython submodule updated.**"
msgstr "**Submódulo de MicroPython actualizado.**"

#: ../../changelog/firmware/v4.1.4.rst:19
msgid ""
"**No breaking API changes** — reflash and your v4.1.3 scripts run unchanged."
msgstr ""
"**Ningún cambio incompatible en la API** — vuelva a flashear y sus scripts "
"de v4.1.3 se ejecutan sin cambios."

#: ../../changelog/firmware/v4.1.4.rst:23
msgid "Other changes and improvements"
msgstr "Otros cambios y mejoras"

#: ../../changelog/firmware/v4.1.4.rst:25
msgid ""
"The bundled MicroPython submodule was updated (upstream fixes and "
"improvements)."
msgstr ""
"Se actualizó el submódulo de MicroPython incluido (correcciones y mejoras "
"del proyecto original)."

#: ../../changelog/firmware/v4.1.4.rst:29
msgid "Breaking API changes"
msgstr "Cambios incompatibles en la API"

#: ../../changelog/firmware/v4.1.4.rst:31
msgid ""
"v4.1.4 introduces **no breaking Python API changes**. Scripts that ran on "
"v4.1.3 run unchanged on v4.1.4 — just reflash the firmware."
msgstr ""
"v4.1.4 no introduce **ningún cambio incompatible en la API de Python**. Los "
"scripts que se ejecutaban en v4.1.3 se ejecutan sin cambios en v4.1.4 — "
"simplemente vuelva a flashear el firmware."
