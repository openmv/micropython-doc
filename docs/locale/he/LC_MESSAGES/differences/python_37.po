msgid ""
"New features include *gc.freeze()*, *gc.unfreeze()*, *gc-get_freeze_count*"
msgstr ""
"תכונות חדשות כוללות *gc.freeze()*\\ , *gc.unfreeze()*\\ , *gc-"
"get_freeze_count*"

