msgstr "אריזת Struct עם מעט מדי ארגומנטים, לא נבדקת על ידי uPy"

#: ../../genrst/modules.rst:342
msgid "Struct pack with too many args, not checked by uPy"
msgstr "אריזת Struct עם יותר מדי ארגומנטים, לא נבדקת על ידי uPy"

#: ../../genrst/modules.rst:367
msgid ""
"Struct pack with whitespace in format, whitespace ignored by CPython, error "
"on uPy"
