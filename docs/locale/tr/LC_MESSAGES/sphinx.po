msgid "Made with the <a href=\"https://shibuya.lepture.com\">Shibuya theme</a>."
msgstr ""
"<a href=\"https://shibuya.lepture.com\">Shibuya theme</a> temasıyla "
"oluşturuldu."

msgid "MicroPython on GitHub"
msgstr "GitHub'da MicroPython"

msgid "Minimal HTTP server — routes, sessions, login, SSE, and WebSockets."
msgstr ""
"Minimal HTTP sunucusu — rotalar, oturumlar, oturum açma, SSE ve "
"WebSocket'ler."

msgid "Monochrome global-shutter sensor for fast-motion capture."
msgstr "Hızlı hareket yakalama için tek renkli global perde sensör."

msgid "More actions"
msgstr "Diğer eylemler"

msgid "More resources"
msgstr "Daha fazla kaynak"

msgid "NXP i.MX RT1062 Cortex-M7 at 600 MHz with 32 MB external SDRAM."
msgstr "32 MB harici SDRAM ile 600 MHz'de NXP i.MX RT1062 Cortex-M7."

msgid "New"
msgstr "Yeni"

msgid "New to OpenMV?"
msgstr "OpenMV'de yeni misiniz?"

msgid "Next"
msgstr "Sonraki"

msgid "No privacy concerns — frames never leave the camera."
msgstr "Gizlilik endişesi yok — kareler asla kamerayı terk etmez."

msgid "Numeric, alphanumeric, binary, and Kanji data modes."
msgstr "Sayısal, alfasayısal, ikili ve Kanji veri modları."

msgid "On this page"
msgstr "Bu sayfada"

msgid "On-device neural network inference — classify, detect, and segment."
msgstr ""
"Cihaz üzerinde sinir ağı çıkarımı — sınıflandırma, algılama ve bölümleme."

msgid "On-device numerical computing — ndarrays, FFTs, and linear algebra."
msgstr ""
"Cihaz üzerinde sayısal hesaplama — ndarray'ler, FFT'ler ve doğrusal cebir."

