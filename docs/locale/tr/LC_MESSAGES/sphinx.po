msgstr "OpenMV MicroPython iç yapısı"

msgid "OpenMV MicroPython language"
msgstr "OpenMV MicroPython dili"

msgid "OpenMV homepage"
msgstr "OpenMV ana sayfası"

msgid "OpenMV on GitHub"
msgstr "GitHub'da OpenMV"

msgid "Overview"
msgstr "Genel Bakış"

msgid "Pass multiple thresholds for multi-color tracking in one call."
msgstr "Tek bir çağrıda çok renkli takip için birden fazla eşik iletin."

msgid ""
"Plug the OpenMV Cam into your computer via USB. A blue heartbeat LED blinks "
"when it's ready."
msgstr ""
"OpenMV Cam'i USB üzerinden bilgisayarınıza takın. Hazır olduğunda mavi bir "
"nabız LED'i yanıp söner."

msgid ""
"Powered by the <a href=\"https://github.com/mchehab/zbar\">ZBar</a> library "
"— recognises EAN, UPC, Code&nbsp;39/93/128, Codabar, ITF, ISBN, and DataBar."
msgstr ""
"<a href=\"https://github.com/mchehab/zbar\">ZBar</a> kütüphanesiyle çalışır "
"— EAN, UPC, Code&nbsp;39/93/128, Codabar, ITF, ISBN ve DataBar'ı tanır."

msgid "Previous"
msgstr "Önceki"

msgid "Products, applications, downloads, and news."
msgstr "Ürünler, uygulamalar, indirmeler ve haberler."

msgid "Prophesee event-based vision — microsecond temporal precision."
msgstr "Prophesee olay tabanlı görüş — mikrosaniye zamansal hassasiyet."

msgid "QR code detection"
msgstr "QR kodu algılama"

msgid "Quick start guide"
msgstr "Hızlı başlangıç kılavuzu"

