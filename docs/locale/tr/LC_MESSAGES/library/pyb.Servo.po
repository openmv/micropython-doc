#: ../../library/pyb.Servo.rst:57
msgid "Methods"
msgstr "Yöntemler"

#: ../../library/pyb.Servo.rst:61
msgid "If no arguments are given, this function returns the current angle."
msgstr "Argüman verilmezse, bu işlev geçerli açıyı döndürür."

#: ../../library/pyb.Servo.rst:63
msgid "If arguments are given, this function sets the angle of the servo:"
msgstr "Argümanlar verilirse, bu işlev servonun açısını ayarlar:"

#: ../../library/pyb.Servo.rst:65
msgid "``angle`` is the angle to move to in degrees."
msgstr "``angle``\\ , derece cinsinden hareket edilecek açıdır."

#: ../../library/pyb.Servo.rst:66
msgid ""
"``time`` is the number of milliseconds to take to get to the specified "
"angle.  If omitted, then the servo moves as quickly as possible to its new "
"position."
msgstr ""
"``time``\\ , belirtilen açıya ulaşmak için harcanacak milisaniye sayısıdır."
"  Atlanırsa servo, yeni konumuna olabildiğince hızlı hareket eder."

#: ../../library/pyb.Servo.rst:72
msgid "If no arguments are given, this function returns the current speed."
msgstr "Argüman verilmezse, bu işlev geçerli hızı döndürür."

#: ../../library/pyb.Servo.rst:74
msgid "If arguments are given, this function sets the speed of the servo:"
msgstr "Argümanlar verilirse, bu işlev servonun hızını ayarlar:"

#: ../../library/pyb.Servo.rst:76
msgid "``speed`` is the speed to change to, between -100 and 100."
msgstr "``speed``\\ , -100 ile 100 arasında değiştirilecek hızdır."

#: ../../library/pyb.Servo.rst:77
msgid ""
"``time`` is the number of milliseconds to take to get to the specified "
"speed.  If omitted, then the servo accelerates as quickly as possible."
msgstr ""
"``time``\\ , belirtilen hıza ulaşmak için harcanacak milisaniye sayısıdır.  "
"Atlanırsa servo, olabildiğince hızlı ivmelenir."

#: ../../library/pyb.Servo.rst:82
msgid ""
"If no arguments are given, this function returns the current raw pulse-width"
" value."
msgstr ""
"Argüman verilmezse, bu işlev geçerli ham darbe genişliği değerini döndürür."

#: ../../library/pyb.Servo.rst:85
msgid "If an argument is given, this function sets the raw pulse-width value."
msgstr "Bir argüman verilirse, bu işlev ham darbe genişliği değerini ayarlar."

#: ../../library/pyb.Servo.rst:89
msgid ""
"If no arguments are given, this function returns the current calibration "
"data, as a 5-tuple."
msgstr ""
"Argüman verilmezse, bu işlev geçerli kalibrasyon verilerini 5 öğeli bir "
"demet olarak döndürür."

#: ../../library/pyb.Servo.rst:92
msgid "If arguments are given, this function sets the timing calibration:"
msgstr "Argümanlar verilirse, bu işlev zamanlama kalibrasyonunu ayarlar:"

#: ../../library/pyb.Servo.rst:94
msgid "``pulse_min`` is the minimum allowed pulse width."
msgstr "``pulse_min``\\ , izin verilen minimum darbe genişliğidir."

#: ../../library/pyb.Servo.rst:95
msgid "``pulse_max`` is the maximum allowed pulse width."
msgstr "``pulse_max``\\ , izin verilen maksimum darbe genişliğidir."

#: ../../library/pyb.Servo.rst:96
msgid ""
"``pulse_centre`` is the pulse width corresponding to the centre/zero "
"position."
msgstr ""
"``pulse_centre``\\ , merkez/sıfır konumuna karşılık gelen darbe "
"genişliğidir."

#: ../../library/pyb.Servo.rst:97
msgid "``pulse_angle_90`` is the pulse width corresponding to 90 degrees."
msgstr "``pulse_angle_90``\\ , 90 dereceye karşılık gelen darbe genişliğidir."

#: ../../library/pyb.Servo.rst:98
msgid ""
"``pulse_speed_100`` is the pulse width corresponding to a speed of 100."
msgstr "``pulse_speed_100``\\ , 100 hızına karşılık gelen darbe genişliğidir."
