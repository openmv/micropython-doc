msgstr "Bağlantı karşı tarafça sıfırlandı."

#: ../../library/errno.rst:105
msgid "No buffer space available."
msgstr "Kullanılabilir tampon alanı yok."

#: ../../library/errno.rst:110
msgid "Socket is not connected."
