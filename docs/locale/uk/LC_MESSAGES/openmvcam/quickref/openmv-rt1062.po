msgstr "VIN живить плату (вимкнений при USB)"

#: ../../openmvcam/quickref/openmv-rt1062.rst:222
msgid "Green"
msgstr "Зелений"

#: ../../openmvcam/quickref/openmv-rt1062.rst:222
msgid "USB or VIN power present"
msgstr "Присутнє живлення від USB або VIN"

#: ../../openmvcam/quickref/openmv-rt1062.rst:223
msgid "Red"
msgstr "Червоний"

#: ../../openmvcam/quickref/openmv-rt1062.rst:223
