msgstr "Налаштовує канал для виходу PWM (активний рівень -- високий)."

#: ../../library/pyb.Timer.rst:292
msgid "Configure the channel for PWM output (active low)."
msgstr "Налаштовує канал для виходу PWM (активний рівень -- низький)."

#: ../../library/pyb.Timer.rst:297
msgid "Output-compare timing mode; no pin is driven."
msgstr "Режим синхронізації порівняння виходу; жоден вивід не керується."

#: ../../library/pyb.Timer.rst:302
msgid "Output-compare active mode; the pin is made active on compare match."
msgstr ""
"Активний режим порівняння виходу; вивід стає активним при збігу порівняння."

#: ../../library/pyb.Timer.rst:307
msgid ""
"Output-compare inactive mode; the pin is made inactive on compare match."
msgstr ""
"Неактивний режим порівняння виходу; вивід стає неактивним при збігу "
"порівняння."

#: ../../library/pyb.Timer.rst:312
msgid "Output-compare toggle mode; the pin toggles on compare match."
msgstr ""
"Режим перемикання порівняння виходу; вивід перемикається при збігу "
"порівняння."

#: ../../library/pyb.Timer.rst:317
msgid ""
"Output-compare forced-active mode; the pin is forced active and the compare "
"match is ignored."
msgstr ""
"Режим примусового активного порівняння виходу; вивід примусово активний, а "
"збіг порівняння ігнорується."

#: ../../library/pyb.Timer.rst:323
msgid ""
"Output-compare forced-inactive mode; the pin is forced inactive and the "
"compare match is ignored."
msgstr ""
"Режим примусового неактивного порівняння виходу; вивід примусово неактивний,"
" а збіг порівняння ігнорується."

#: ../../library/pyb.Timer.rst:329
