msgstr "Više radnji"

msgid "More resources"
msgstr "Više resursa"

msgid "NXP i.MX RT1062 Cortex-M7 at 600 MHz with 32 MB external SDRAM."
msgstr "NXP i.MX RT1062 Cortex-M7 na 600 MHz s 32 MB vanjskog SDRAM-a."

