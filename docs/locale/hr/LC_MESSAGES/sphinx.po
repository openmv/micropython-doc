msgid "MicroPython on GitHub"
msgstr "MicroPython na GitHub-u"

msgid "Minimal HTTP server — routes, sessions, login, SSE, and WebSockets."
msgstr "Minimalni HTTP poslužitelj — rute, sesije, prijava, SSE i WebSockets."

msgid "Monochrome global-shutter sensor for fast-motion capture."
msgstr "Monokromatski global-shutter senzor za hvatanje brzih pokreta."

