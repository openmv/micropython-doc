msgstr "Forumi"

msgid "GENX320 event sensor + PAG7936 colour on one module."
msgstr "GENX320 event senzor + PAG7936 kolor na jednom modulu."

msgid "Gigabit Ethernet with PoE for higher-bandwidth streaming."
msgstr "Gigabit Ethernet s PoE za streaming veće propusnosti."

msgid ""
"Google's BlazeFace is a lightweight TensorFlow Lite face detector that "
"returns bounding boxes plus six landmarks per face."
msgstr ""
"Google BlazeFace je lagani TensorFlow Lite detektor lica koji vraća okvire "
"granica plus šest ključnih točaka po licu."

msgid ""
"Google's MediaPipe Hand Landmarks model places 21 joints on each detected "
"hand — wrist, knuckles, and fingertips."
msgstr ""
"Google MediaPipe Hand Landmarks model postavlja 21 zglob na svaku "
"detektiranu ruku — zapešće, zglobovi prstiju i vrhovi prstiju."

msgid "Hand landmarks"
msgstr "Ključne točke ruke"

msgid "Hardware"
msgstr "Hardver"

msgid ""
"Hardware, cameras, image processing, ndarrays, ML, multitasking, networking,"
" web servers, and Bluetooth — all from MicroPython."
msgstr ""
"Hardver, kamere, obrada slika, ndarray-i, ML, višezadaćnost, umrežavanje, "
"web poslužitelji i Bluetooth — sve iz MicroPython-a."

msgid "Hello world"
msgstr "Pozdrav svijetu"

msgid "Home"
msgstr "Početna"

msgid "Internals"
msgstr "Unutarnja struktura"

