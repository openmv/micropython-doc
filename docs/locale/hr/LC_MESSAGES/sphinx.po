msgstr "Prethodno"

msgid "Products, applications, downloads, and news."
msgstr "Proizvodi, aplikacije, preuzimanja i vijesti."

msgid "Prophesee event-based vision — microsecond temporal precision."
msgstr ""
"Prophesee vizija temeljena na događajima — mikrosekudna vremenska "
"preciznost."

msgid "QR code detection"
msgstr "Otkrivanje QR koda"

