msgstr "Na ovoj stranici"

msgid "On-device neural network inference — classify, detect, and segment."
msgstr ""
"Inferencija neuronske mreže na uređaju — klasificirati, detektirati i "
"segmentirati."

msgid "On-device numerical computing — ndarrays, FFTs, and linear algebra."
msgstr ""
"Numeričko računanje na uređaju — ndarray-i, FFT-ovi i linearna algebra."

