#: ../../legacy/cmucam3/hardware-leds.rst:2
msgid "LEDS"
msgstr "LED diode"

#: ../../legacy/cmucam3/hardware-leds.rst:4
msgid ""
"**LED 0** -- This pin is shared with the MOSI pin and should be used only "
"when CS is disabled while an MMC card is inserted."
msgstr ""
"**LED 0** -- Ovaj se pin dijeli s MOSI pinom i trebao bi se koristiti samo "
"kada je CS onemogućen dok je MMC kartica umetnuta."

#: ../../legacy/cmucam3/hardware-leds.rst:6
msgid ""
"**LED 1** -- This pin is shared with the Servo 2 pin. When using Servo 2, "
"the LED will flash."
msgstr ""
"**LED 1** -- Ovaj se pin dijeli s pinom Servo 2. Kada koristite Servo 2, LED"
" će treptati."

#: ../../legacy/cmucam3/hardware-leds.rst:8
msgid ""
"**LED 2** -- This pin is shared with the Servo 3 pin. When using Servo 3, "
"the LED will flash."
msgstr ""
"**LED 2** -- Ovaj se pin dijeli s pinom Servo 3. Kada koristite Servo 3, LED"
" će treptati."

#: ../../legacy/cmucam3/hardware-leds.rst:11
msgid "(LEDs image ``leds.png`` -- not preserved in the archive.)"
msgstr "(Slika LED dioda ``leds.png`` -- nije sačuvana u arhivi.)"
