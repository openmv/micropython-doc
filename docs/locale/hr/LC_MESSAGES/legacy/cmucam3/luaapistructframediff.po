msgid "``fdiff:swap_templates``"
msgstr "``fdiff:swap_templates``"

#: ../../legacy/cmucam3/luaapistructframediff.rst:244
msgid ""
"Swaps the current and previous template in this framediff structure. This "
"function puts the current_template in the previous_template, and vice versa."
msgstr ""
"Zamjenjuje trenutni i prethodni predložak u ovoj framediff strukturi. Ova "
"funkcija stavlja current_template u previous_template i obrnuto."
