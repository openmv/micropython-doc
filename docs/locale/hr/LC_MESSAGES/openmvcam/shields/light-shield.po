msgid "Highlights"
msgstr "Istaknute značajke"

#: ../../openmvcam/shields/light-shield.rst:17
msgid "Nine high-power white LEDs"
msgstr "Devet snažnih bijelih LED dioda"

#: ../../openmvcam/shields/light-shield.rst:18
msgid "PWM dimming control from the OpenMV Cam"
msgstr "Upravljanje zatamnjenjem preko PWM-a s OpenMV Cam"

