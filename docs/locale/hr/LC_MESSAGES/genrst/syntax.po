#: ../../genrst/syntax.rst:46
msgid "Operators"
msgstr "Operatori"

#: ../../genrst/syntax.rst:51
msgid ""
"MicroPython allows using := to assign to the variable of a comprehension, "
"CPython raises a SyntaxError."
msgstr ""
"MicroPython dopušta korištenje := za dodjelu varijabli razumijevanja, "
"CPython podiže SyntaxError."

#: ../../genrst/syntax.rst:53
msgid ""
"**Cause:** MicroPython is optimised for code size and doesn't check this "
"case."
msgstr ""
"**Uzrok:** MicroPython je optimiziran za veličinu koda i ne provjerava ovaj "
"slučaj."

#: ../../genrst/syntax.rst:55
msgid ""
"**Workaround:** Do not rely on this behaviour if writing CPython compatible "
"code."
msgstr ""
"**Zaobilazno rješenje:** Ne oslanjajte se na ovo ponašanje pri pisanju koda "
"kompatibilnog s CPythonom."

#: ../../genrst/syntax.rst:73
msgid "Spaces"
msgstr "Razmaci"

#: ../../genrst/syntax.rst:78
msgid "uPy requires spaces between literal numbers and keywords, CPy doesn't"
msgstr ""
"uPy zahtijeva razmake između literalnih brojeva i ključnih riječi, CPy ne "
"zahtijeva"

#: ../../genrst/syntax.rst:107
msgid "Unicode"
msgstr "Unicode"

#: ../../genrst/syntax.rst:112
msgid "Unicode name escapes are not implemented"
msgstr "Izlazne sekvence Unicode naziva nisu implementirane"
