#: ../../genrst/syntax.rst:10
msgid ""
"Argument unpacking does not work if the argument being unpacked is the nth "
"or greater argument where n is the number of bits in an MP_SMALL_INT."
msgstr ""
"Raspakiranje argumenata ne funkcionira ako je argument koji se raspakirava "
"n-ti ili viši argument, gdje je n broj bita u MP_SMALL_INT."

#: ../../genrst/syntax.rst:12
msgid ""
"**Cause:** The implementation uses an MP_SMALL_INT to flag args that need to"
" be unpacked."
msgstr ""
"**Uzrok:** Implementacija koristi MP_SMALL_INT za označavanje argumenata "
"koji trebaju biti raspakirani."

#: ../../genrst/syntax.rst:14
msgid "**Workaround:** Use fewer arguments."
msgstr "**Zaobilazno rješenje:** Koristite manje argumenata."

