msgid ""
"CAN FD with all of the optional features enabled (FD frame, bit-rate "
"switching, extended frame IDs; 500 kbit/s arbitration phase, 1 Mbit/s data "
"phase)::"
msgstr ""
"CAN FD sa svim uključenim opcionalnim značajkama (FD okvir, prebacivanje "
"brzine prijenosa, prošireni ID-ovi okvira; arbitražna faza od 500 kbit/s, "
"podatkovna faza od 1 Mbit/s)::"

