#: ../../library/pyb.rst:250
msgid ""
"``mountpoint`` is the path in the root of the filesystem to mount the device"
" at; it must begin with a forward slash. ``readonly`` forces a read-only "
"mount. ``mkfs`` creates a new filesystem if none is present."
msgstr ""
"``mountpoint`` je putanja u korijenu datotečnog sustava na koju se montira "
"uređaj; mora počinjati kosom crtom. ``readonly`` prisiljava montiranje samo "
"za čitanje. ``mkfs`` stvara novi datotečni sustav ako nijedan ne postoji."

#: ../../library/pyb.rst:256
msgid "Get or set the UART object where the REPL is repeated on."
msgstr "Dohvati ili postavi UART objekt na kojem se ponavlja REPL."

#: ../../library/pyb.rst:260
msgid "Return a 30-bit hardware generated random number."
msgstr "Vraća 30-bitni hardverski generirani slučajni broj."

#: ../../library/pyb.rst:264
msgid "Sync all file systems."
msgstr "Sinkronizira sve datotečne sustave."

#: ../../library/pyb.rst:268
