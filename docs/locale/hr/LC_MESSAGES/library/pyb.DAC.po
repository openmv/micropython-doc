#: ../../library/pyb.DAC.rst:7
msgid ""
"The DAC outputs analog voltages between 0 V and 3.3 V on one of two STM32 "
"DAC channels."
msgstr ""
"DAC izlaže analogne napone između 0 V i 3,3 V na jednom od dva STM32 DAC "
"kanala."

