msgstr ""
"Radi se o direktoriju (operacija koja zahtijeva datoteku primijenjena je na "
"direktorij)."

#: ../../library/errno.rst:80
msgid "Invalid argument."
msgstr "Neispravan argument."

#: ../../library/errno.rst:85
