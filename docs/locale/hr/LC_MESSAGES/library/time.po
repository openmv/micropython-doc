msgstr "month   je 1-12"

#: ../../library/time.rst:47
msgid "mday    is 1-31"
msgstr "mday    je 1-31"

#: ../../library/time.rst:48
msgid "hour    is 0-23"
msgstr "hour    je 0-23"

#: ../../library/time.rst:49
msgid "minute  is 0-59"
msgstr "minute  je 0-59"

#: ../../library/time.rst:50
msgid "second  is 0-59"
msgstr "second  je 0-59"

#: ../../library/time.rst:51
msgid "weekday is 0-6 for Mon-Sun"
msgstr "weekday je 0-6 za pon-ned"

#: ../../library/time.rst:52
