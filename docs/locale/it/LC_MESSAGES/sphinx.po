msgstr "MicroPython su GitHub"

msgid "Minimal HTTP server — routes, sessions, login, SSE, and WebSockets."
msgstr "Server HTTP minimale — route, sessioni, login, SSE e WebSocket."

msgid "Monochrome global-shutter sensor for fast-motion capture."
msgstr ""
"Sensore monocromatico global-shutter per acquisizione di movimenti rapidi."

msgid "More actions"
msgstr "Altre azioni"

msgid "More resources"
msgstr "Altre risorse"

msgid "NXP i.MX RT1062 Cortex-M7 at 600 MHz with 32 MB external SDRAM."
msgstr "NXP i.MX RT1062 Cortex-M7 a 600 MHz con 32 MB di SDRAM esterna."

msgid "New"
msgstr "Nuovo"

msgid "New to OpenMV?"
msgstr "Nuovo su OpenMV?"

msgid "Next"
msgstr "Successivo"

msgid "No privacy concerns — frames never leave the camera."
msgstr "Nessun problema di privacy — i frame non lasciano mai la fotocamera."

msgid "Numeric, alphanumeric, binary, and Kanji data modes."
msgstr "Modalità dati numerica, alfanumerica, binaria e Kanji."

msgid "On this page"
msgstr "In questa pagina"

msgid "On-device neural network inference — classify, detect, and segment."
msgstr ""
"Inferenza di reti neurali sul dispositivo — classifica, rileva e segmenta."

msgid "On-device numerical computing — ndarrays, FFTs, and linear algebra."
msgstr "Calcolo numerico sul dispositivo — ndarray, FFT e algebra lineare."

