#: ../../legacy/cmucam4/command-list-user-manual.rst:2
msgid "Command List User Manual"
msgstr "Manuale utente dell'elenco dei comandi"

#: ../../legacy/cmucam4/command-list-user-manual.rst:4
msgid ""
"The CMUcam4's command list contains information about the serial "
"communication setup, the recommended serial terminal programs, the command "
"listing, the serial communication flowchart, data packet descriptions, and "
"error message descriptions."
msgstr ""
"L'elenco dei comandi della CMUcam4 contiene informazioni sulla "
"configurazione della comunicazione seriale, i programmi di terminale seriale"
" consigliati, l'elenco dei comandi, il diagramma di flusso della "
"comunicazione seriale, le descrizioni dei pacchetti di dati e le descrizioni"
" dei messaggi di errore."

