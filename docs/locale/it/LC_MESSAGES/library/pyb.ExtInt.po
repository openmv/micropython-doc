msgid "Constants"
msgstr "Costanti"

#: ../../library/pyb.ExtInt.rst:119
msgid "Trigger an interrupt on a rising edge. The Python callback runs."
msgstr ""
"Attiva un interrupt su un fronte di salita. Il callback Python viene "
"eseguito."

#: ../../library/pyb.ExtInt.rst:124
msgid "Trigger an interrupt on a falling edge. The Python callback runs."
msgstr ""
"Attiva un interrupt su un fronte di discesa. Il callback Python viene "
"eseguito."

#: ../../library/pyb.ExtInt.rst:129
msgid "Trigger an interrupt on either edge. The Python callback runs."
msgstr ""
"Attiva un interrupt su entrambi i fronti. Il callback Python viene eseguito."

#: ../../library/pyb.ExtInt.rst:134
msgid ""
"Route a rising edge to the Cortex event input. No Python callback is "
"invoked; intended for use with the ``WFE`` instruction in low-power code."
msgstr ""
"Instrada un fronte di salita all'ingresso evento del Cortex. Non viene "
"invocato alcun callback Python; pensato per l'uso con l'istruzione ``WFE`` "
"nel codice a basso consumo."

#: ../../library/pyb.ExtInt.rst:141
msgid ""
"Route a falling edge to the Cortex event input. No Python callback is "
"invoked."
msgstr ""
"Instrada un fronte di discesa all'ingresso evento del Cortex. Non viene "
"invocato alcun callback Python."

#: ../../library/pyb.ExtInt.rst:147
msgid ""
"Route either edge to the Cortex event input. No Python callback is invoked."
msgstr ""
"Instrada entrambi i fronti all'ingresso evento del Cortex. Non viene "
"invocato alcun callback Python."
