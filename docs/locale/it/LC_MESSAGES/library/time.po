msgid "Methods"
msgstr "Metodi"

#: ../../library/time.rst:258
msgid "Starts tracking elapsed time."
msgstr "Avvia il tracciamento del tempo trascorso."

#: ../../library/time.rst:262
msgid ""
"Stops tracking the elapsed time and returns the current FPS (frames per "
"second)."
msgstr ""
"Interrompe il tracciamento del tempo trascorso e restituisce gli FPS (frame "
"al secondo) correnti."

#: ../../library/time.rst:265 ../../library/time.rst:272
msgid "Always call ``tick`` first before calling this function."
msgstr "Chiama sempre ``tick`` prima di chiamare questa funzione."

#: ../../library/time.rst:269
msgid ""
"Stops tracking the elapsed time and returns the current average elapsed time"
" in milliseconds."
msgstr ""
"Interrompe il tracciamento del tempo trascorso e restituisce il tempo medio "
"trascorso corrente in millisecondi."

#: ../../library/time.rst:276
msgid "Resets the clock object."
msgstr "Reimposta l'oggetto clock."
