msgid "Operation not permitted."
msgstr "Operazione non consentita."

#: ../../library/errno.rst:33
msgid "No such file or directory."
msgstr "File o directory inesistente."

#: ../../library/errno.rst:38
msgid "I/O error."
msgstr "Errore di I/O."

#: ../../library/errno.rst:43
msgid "Bad file descriptor."
msgstr "Descrittore di file non valido."

#: ../../library/errno.rst:48
msgid ""
"Resource temporarily unavailable. Returned by a non-blocking operation (e.g."
" a socket read/write) that would otherwise block."
msgstr ""
"Risorsa temporaneamente non disponibile. Restituito da un'operazione non "
"bloccante (ad esempio una lettura/scrittura su socket) che altrimenti si "
"bloccherebbe."

#: ../../library/errno.rst:54
msgid "Out of memory."
msgstr "Memoria esaurita."

