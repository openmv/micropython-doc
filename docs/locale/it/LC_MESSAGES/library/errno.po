msgstr "Host irraggiungibile (nessuna route verso l'host)."

#: ../../library/errno.rst:130
msgid "Operation already in progress."
msgstr "Operazione già in corso."

#: ../../library/errno.rst:135
msgid "Operation now in progress (e.g. a non-blocking ``connect()``)."
msgstr "Operazione ora in corso (ad esempio una ``connect()`` non bloccante)."

