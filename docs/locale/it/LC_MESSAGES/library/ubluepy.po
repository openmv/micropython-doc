msgid ""
"**s140** (Nano 33 BLE Sense) --- both peripheral *and* central (scanner) "
"roles. This is what the OpenMV firmware ships."
msgstr ""
"**s140** (Nano 33 BLE Sense) --- entrambi i ruoli, periferica *e* centrale "
"(scanner). È quanto distribuisce il firmware OpenMV."

#: ../../library/ubluepy.rst:22
msgid "**s132** --- both peripheral and central."
msgstr "**s132** --- sia periferica che centrale."

#: ../../library/ubluepy.rst:23
msgid ""
"**s110** --- peripheral only; scanner / connect methods are compiled out."
msgstr ""
"**s110** --- solo periferica; i metodi scanner / connect sono esclusi dalla "
"compilazione."

