msgid "Both of the constants below are ready-made 5-tuples in the form"
msgstr ""
"Entrambe le costanti seguenti sono tuple di 5 elementi già pronte nella "
"forma"

#: ../../library/pyb.rst:326
msgid ""
"``(subclass, protocol, max_packet_size, polling_interval_ms, "
"report_descriptor)``"
msgstr ""
"``(subclass, protocol, max_packet_size, polling_interval_ms, "
