#: ../../genrst/syntax.rst:46
msgid "Operators"
msgstr "Operatori"

#: ../../genrst/syntax.rst:51
msgid ""
"MicroPython allows using := to assign to the variable of a comprehension, "
"CPython raises a SyntaxError."
msgstr ""
"MicroPython consente di usare := per assegnare alla variabile di una "
"comprensione, mentre CPython genera un SyntaxError."

#: ../../genrst/syntax.rst:53
msgid ""
"**Cause:** MicroPython is optimised for code size and doesn't check this "
"case."
msgstr ""
"**Causa:** MicroPython è ottimizzato per la dimensione del codice e non "
"controlla questo caso."

#: ../../genrst/syntax.rst:55
msgid ""
"**Workaround:** Do not rely on this behaviour if writing CPython compatible "
"code."
msgstr ""
"**Soluzione alternativa:** Non fare affidamento su questo comportamento "
"quando si scrive codice compatibile con CPython."

#: ../../genrst/syntax.rst:73
msgid "Spaces"
msgstr "Spazi"

#: ../../genrst/syntax.rst:78
msgid "uPy requires spaces between literal numbers and keywords, CPy doesn't"
msgstr "uPy richiede spazi tra numeri letterali e parole chiave, CPy no"

#: ../../genrst/syntax.rst:107
msgid "Unicode"
msgstr "Unicode"

#: ../../genrst/syntax.rst:112
msgid "Unicode name escapes are not implemented"
msgstr "Le sequenze di escape per nomi Unicode non sono implementate"
